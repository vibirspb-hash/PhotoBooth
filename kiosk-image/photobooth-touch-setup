#!/usr/bin/env bash
set -u

device_name="HID 1aad:0001"
default_calibration="5640 7620 691 2308"
log_file="${PHOTOBOOTH_DATA_ROOT:-/tmp}/Diagnostics/touchscreen.log"

mkdir -p "$(dirname "$log_file")"
exec >>"$log_file" 2>&1

echo "$(date --iso-8601=seconds) Configuring KeeTouch"

for _ in $(seq 1 10); do
  if xinput list --id-only "$device_name" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

device_id="$(xinput list --id-only "$device_name" 2>/dev/null | head -n 1 || true)"
pointer_id="$(xinput list --id-only 'Virtual core pointer' 2>/dev/null | head -n 1 || true)"

if [[ -z "$device_id" || -z "$pointer_id" ]]; then
  echo "KeeTouch or the X11 pointer was not found."
  xinput list || true
  exit 0
fi

# Keep the hardware behavior of the confirmed c30fa9a build.
# Only KeeTouch is modified. Mouse and keyboard are never touched here.
xinput reattach "$device_id" "$pointer_id" || true
xinput enable "$device_id" || true
xinput set-mode "$device_id" ABSOLUTE || true

apply_calibration() {
  local values="$1"
  local min_x max_x min_y max_y

  read -r min_x max_x min_y max_y <<< "$values"

  if ! (( min_x < max_x &&
          min_y < max_y &&
          max_x - min_x > 500 &&
          max_y - min_y > 500 )); then
    return 1
  fi

  xinput set-prop "$device_id" "Evdev Axis Calibration" \
    "$min_x" "$max_x" "$min_y" "$max_y"
}

# Always start from the known full-screen KeeTouch profile.
if apply_calibration "$default_calibration"; then
  echo "Applied built-in KeeTouch calibration: $default_calibration"
else
  echo "Failed to apply built-in KeeTouch calibration: $default_calibration"
fi

# SwapAxes=false
xinput set-prop "$device_id" "Evdev Axes Swap" 0 2>/dev/null || true

data_root="${PHOTOBOOTH_DATA_ROOT:-/media/$USER/PHOTOBOOTH}"
saved_calibration="$data_root/Diagnostics/99-keetouch-calibration.conf"

if [[ -f "$saved_calibration" ]]; then
  calibration_values="$(
    sed -n 's/.*Option[[:space:]]*"Calibration"[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$saved_calibration" | head -n 1
  )"

  if [[ "$calibration_values" =~ ^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$ ]]; then
    if apply_calibration "$calibration_values"; then
      echo "Restored validated KeeTouch calibration: $calibration_values"
    else
      echo "Ignored invalid saved KeeTouch calibration: $calibration_values"
    fi
  else
    echo "Ignored malformed saved KeeTouch calibration."
  fi
fi

xinput list-props "$device_id" || true
echo "KeeTouch $device_id is attached to pointer $pointer_id."
