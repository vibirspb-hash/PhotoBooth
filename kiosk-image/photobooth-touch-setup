#!/usr/bin/env bash
set -u
export LC_ALL=C

device_name="HID 1aad:0001"
log_file="${PHOTOBOOTH_DATA_ROOT:-/tmp}/Diagnostics/touchscreen.log"
mkdir -p "$(dirname "$log_file")"
exec >>"$log_file" 2>&1

echo "$(date --iso-8601=seconds) Configuring KeeTouch"
for _ in $(seq 1 6); do
  if xinput list --id-only "$device_name" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

device_id="$(xinput list --id-only "$device_name" 2>/dev/null || true)"
pointer_id="$(xinput list --id-only 'Virtual core pointer' 2>/dev/null || true)"
if [[ -z "$device_id" || -z "$pointer_id" ]]; then
  echo "KeeTouch or the X11 pointer was not found."
  xinput list || true
  exit 0
fi

xinput reattach "$device_id" "$pointer_id" || true
xinput enable "$device_id" || true
xinput set-mode "$device_id" ABSOLUTE || true

data_root="${PHOTOBOOTH_DATA_ROOT:-/media/$USER/PHOTOBOOTH}"
saved_calibration="$data_root/Diagnostics/99-keetouch-calibration.conf"
saved_properties="$data_root/Diagnostics/touch-runtime-properties.txt"
if [[ -f "$saved_calibration" ]]; then
  calibration_values="$(
    sed -n 's/.*Option[[:space:]]*"Calibration"[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$saved_calibration" | head -n 1
  )"
  if [[ "$calibration_values" =~ ^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$ ]]; then
    read -r min_x max_x min_y max_y <<< "$calibration_values"
    xinput set-prop "$device_id" "Evdev Axis Calibration" \
      "$min_x" "$max_x" "$min_y" "$max_y" || true
    echo "Restored saved KeeTouch calibration: $calibration_values"
  fi
fi

restore_property() {
  local property_name="$1"
  local expected_count="$2"
  local raw_values normalized_values
  local -a values

  raw_values="$(
    sed -n "s/^[[:space:]]*${property_name} ([0-9][0-9]*):[[:space:]]*//p" \
      "$saved_properties" | head -n 1
  )"
  normalized_values="${raw_values//,/ }"
  read -r -a values <<< "$normalized_values"
  if (( ${#values[@]} == expected_count )); then
    xinput set-prop "$device_id" "$property_name" "${values[@]}" || true
    echo "Restored $property_name: ${values[*]}"
  fi
}

if [[ -f "$saved_properties" ]]; then
  restore_property "Evdev Axis Calibration" 4
  restore_property "libinput Calibration Matrix" 9
  restore_property "Coordinate Transformation Matrix" 9
fi

xinput list-props "$device_id" || true
echo "KeeTouch $device_id is attached to pointer $pointer_id."
