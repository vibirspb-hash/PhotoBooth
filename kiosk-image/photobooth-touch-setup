#!/usr/bin/env bash
set -u
export LC_ALL=C

device_name="HID 1aad:0001"
log_file="${PHOTOBOOTH_DATA_ROOT:-/tmp}/Diagnostics/touchscreen.log"
mkdir -p "$(dirname "$log_file")"
exec >>"$log_file" 2>&1

echo "$(date --iso-8601=seconds) Configuring KeeTouch"
for _ in $(seq 1 6); do
  if xinput list --id-only "$device_name" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

device_id="$(xinput list --id-only "$device_name" 2>/dev/null || true)"
pointer_id="$(xinput list --id-only 'Virtual core pointer' 2>/dev/null || true)"
if [[ -z "$device_id" || -z "$pointer_id" ]]; then
  echo "KeeTouch or the X11 pointer was not found."
  xinput list || true
  exit 0
fi

xinput reattach "$device_id" "$pointer_id" || true
xinput enable "$device_id" || true
xinput set-mode "$device_id" ABSOLUTE || true

data_root="${PHOTOBOOTH_DATA_ROOT:-/media/$USER/PHOTOBOOTH}"
saved_calibration="$data_root/Diagnostics/99-keetouch-calibration.conf"
system_calibration="/etc/X11/xorg.conf.d/99-keetouch-calibration.conf"
# This booth has a fixed KeeTouch panel. The system profile is applied before
# Xorg starts and again here, so stale calibration data cannot break startup.
calibration_file="$system_calibration"

if [[ -f "$calibration_file" ]]; then
  calibration_values="$(
    sed -n 's/.*Option[[:space:]]*"Calibration"[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$calibration_file" | head -n 1
  )"
  if [[ "$calibration_values" =~ ^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$ ]]; then
    read -r min_x max_x min_y max_y <<< "$calibration_values"
    xinput set-prop "$device_id" "Evdev Axis Calibration" \
      "$min_x" "$max_x" "$min_y" "$max_y" || true
    echo "Applied built-in KeeTouch calibration: $calibration_values"
  else
    read_option() {
      local option_name="$1"
      sed -n "s/.*Option[[:space:]]*\"${option_name}\"[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
        "$calibration_file" | head -n 1
    }

    min_x="$(read_option MinX)"
    max_x="$(read_option MaxX)"
    min_y="$(read_option MinY)"
    max_y="$(read_option MaxY)"
    if [[ "$min_x $max_x $min_y $max_y" =~ ^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$ ]]; then
      xinput set-prop "$device_id" "Evdev Axis Calibration" \
        "$min_x" "$max_x" "$min_y" "$max_y" || true
      echo "Applied built-in KeeTouch Min/Max calibration: $min_x $max_x $min_y $max_y"
    fi
  fi

  swap_axes="$(
    sed -n 's/.*Option[[:space:]]*"SwapAxes"[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$calibration_file" | head -n 1
  )"
  case "${swap_axes,,}" in
    1|true|yes|on)
      xinput set-prop "$device_id" "Evdev Axes Swap" 1 || true
      echo "Applied built-in KeeTouch axis swap: 1"
      ;;
    0|false|no|off)
      xinput set-prop "$device_id" "Evdev Axes Swap" 0 || true
      echo "Applied built-in KeeTouch axis swap: 0"
      ;;
  esac
fi

if [[ -f "$saved_calibration" ]]; then
  echo "Ignored stale user calibration: $saved_calibration"
fi

xinput list-props "$device_id" || true
echo "KeeTouch $device_id is attached to pointer $pointer_id."
