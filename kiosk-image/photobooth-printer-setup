#!/usr/bin/env bash
set -euo pipefail

queue_name="DNP_RX1"
printer_uri=""
log_file="/var/log/photobooth-printer-setup.log"
lpinfo_command="/usr/sbin/lpinfo"
lpadmin_command="/usr/sbin/lpadmin"
cupsenable_command="/usr/sbin/cupsenable"
cupsaccept_command="/usr/sbin/cupsaccept"
exec >>"$log_file" 2>&1

echo "$(date --iso-8601=seconds) Configuring DNP DS-RX1"
systemctl start cups.service

if [[ ! -x "$lpinfo_command" ]]; then
  echo "CUPS lpinfo is missing at $lpinfo_command."
  exit 0
fi

for _ in $(seq 1 30); do
  printer_uri="$(
    "$lpinfo_command" -v 2>/dev/null |
      awk '
        tolower($0) ~ /(dnp|citizen|ds-?rx1|dsrx1|dnprx1|1343.*0005)/ {print $2; exit}
      '
  )"
  [[ -n "$printer_uri" ]] && break
  sleep 1
done

if [[ -z "$printer_uri" ]]; then
  echo "DNP DS-RX1 is not available through the Gutenprint USB backend."
  echo "USB devices:"
  lsusb || true
  echo "CUPS devices:"
  "$lpinfo_command" -v || true
  exit 0
fi

driver_name="$(
  "$lpinfo_command" -m 2>/dev/null |
    awk 'tolower($0) ~ /(ds-?rx1|dsrx1|dnprx1)/ {print $1; exit}'
)"

if [[ -z "$driver_name" ]]; then
  echo "DNP DS-RX1 was detected, but its Gutenprint driver is unavailable." >&2
  "$lpinfo_command" -m | grep -Ei 'dnp|rx1' || true
  exit 0
fi

configured_uri="$(
  lpstat -v "$queue_name" 2>/dev/null |
    sed -n 's/^device for [^:]*: //p'
)"

if [[ "$configured_uri" != "$printer_uri" ]]; then
  "$lpadmin_command" -p "$queue_name" -E -v "$printer_uri" -m "$driver_name"
fi

"$lpadmin_command" -d "$queue_name"
"$cupsenable_command" "$queue_name"
"$cupsaccept_command" "$queue_name"

echo "Printer queue $queue_name is ready at $printer_uri."
lpstat -p "$queue_name" -l
