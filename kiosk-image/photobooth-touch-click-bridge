#!/usr/bin/env bash
set -u

device_name="HID 1aad:0001"
idle_ms="${PHOTOBOOTH_TOUCH_CLICK_IDLE_MS:-250}"
log_file="${PHOTOBOOTH_DATA_ROOT:-/tmp}/Diagnostics/touch-click-bridge.log"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/photobooth-touch-click-bridge.lock"

mkdir -p "$(dirname "$log_file")"
exec 9>"$lock_file"
if ! flock -n 9; then
  exit 0
fi

exec >>"$log_file" 2>&1
echo "$(date --iso-8601=seconds) Starting KeeTouch click bridge"

if ! command -v xdotool >/dev/null 2>&1; then
  echo "xdotool is not installed; touch clicks cannot be generated."
  exit 0
fi

while true; do
  if ! xinput list --id-only "$device_name" >/dev/null 2>&1; then
    sleep 1
    continue
  fi

  last_motion_ms=0
  while IFS= read -r event; do
    # This legacy controller sends X/Y and pressure (a[2]), but never sends
    # BTN_TOUCH or button 1. Treat the first pressure report after an idle gap
    # as one kiosk tap. Further reports from the same contact are ignored.
    if [[ "$event" != motion* || "$event" != *'a[2]='* ]]; then
      continue
    fi

    now_ms="$(date +%s%3N)"
    if (( last_motion_ms == 0 || now_ms - last_motion_ms >= idle_ms )); then
      xdotool click 1 || true
    fi
    last_motion_ms="$now_ms"
  done < <(stdbuf -oL xinput test "$device_name" 2>&1)

  echo "$(date --iso-8601=seconds) KeeTouch event stream stopped; retrying"
  sleep 1
done
