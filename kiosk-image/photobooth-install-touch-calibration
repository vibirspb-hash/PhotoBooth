#!/usr/bin/env bash
set -euo pipefail

source_file="${1:-}"
target_file="/etc/X11/xorg.conf.d/99-keetouch-calibration.conf"
temporary_file="$(mktemp)"
trap 'rm -f "$temporary_file"' EXIT

resolved_source="$(realpath "$source_file" 2>/dev/null || true)"
if [[ ! -f "$source_file" || "$resolved_source" != /tmp/* ]]; then
  echo "Calibration source is invalid." >&2
  exit 1
fi

sed -n '/Section "InputClass"/,/EndSection/p' "$source_file" >"$temporary_file"
if ! grep -Fq 'HID 1aad:0001' "$temporary_file"; then
  echo "Calibration data does not belong to the PhotoBooth touchscreen." >&2
  exit 1
fi

if ! grep -q 'Option[[:space:]]*"Calibration"' "$temporary_file" &&
   ! { grep -q 'Option[[:space:]]*"MinX"' "$temporary_file" &&
       grep -q 'Option[[:space:]]*"MaxX"' "$temporary_file" &&
       grep -q 'Option[[:space:]]*"MinY"' "$temporary_file" &&
       grep -q 'Option[[:space:]]*"MaxY"' "$temporary_file"; }; then
  echo "Calibration data does not contain supported axis values." >&2
  exit 1
fi

install -D -m 0644 "$temporary_file" "$target_file"
echo "Installed $target_file"

data_root="/media/${SUDO_USER:-user}/PHOTOBOOTH"
if mountpoint -q "$data_root"; then
  diagnostics_dir="$data_root/Diagnostics"
  mkdir -p "$diagnostics_dir"
  install -m 0644 "$temporary_file" \
    "$diagnostics_dir/99-keetouch-calibration.conf"
  chown "${SUDO_USER:-user}:${SUDO_USER:-user}" \
    "$diagnostics_dir/99-keetouch-calibration.conf" || true
  echo "Exported calibration to $diagnostics_dir"
fi
