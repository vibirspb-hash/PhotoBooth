#!/usr/bin/env bash
set -euo pipefail

log_file="/var/log/photobooth-first-boot.log"
exec >>"$log_file" 2>&1

echo "$(date --iso-8601=seconds) Checking PhotoBooth storage"

medium_source="$(findmnt -nro SOURCE /run/live/medium 2>/dev/null || true)"
if [[ -z "$medium_source" ]]; then
  echo "Live medium was not found; skipping automatic partitioning"
  exit 0
fi

if [[ "$(lsblk -ndo TYPE "$medium_source" 2>/dev/null || true)" == "disk" ]]; then
  disk="$medium_source"
else
  parent="$(lsblk -ndo PKNAME "$medium_source" 2>/dev/null || true)"
  disk="/dev/$parent"
fi

if [[ ! -b "$disk" ]]; then
  echo "Unable to determine boot disk from $medium_source"
  exit 1
fi

photobooth_label="$(lsblk -nrpo LABEL "$disk" | grep -Fx PHOTOBOOTH || true)"
persistence_label="$(lsblk -nrpo LABEL "$disk" | grep -Fx persistence || true)"
if [[ -n "$photobooth_label" && -n "$persistence_label" ]]; then
  echo "Persistence and template volumes already exist on $disk"
  exit 0
fi

if [[ -n "$photobooth_label" || -n "$persistence_label" ]]; then
  echo "Storage layout on $disk is incomplete; reflash the PhotoBooth image"
  exit 1
fi

transport="$(lsblk -ndo TRAN "$disk" 2>/dev/null || true)"
removable="$(lsblk -ndo RM "$disk" 2>/dev/null || echo 0)"
if [[ "$transport" != "usb" && "$removable" != "1" ]]; then
  echo "Refusing to partition $disk because it is not identified as USB storage"
  exit 1
fi

iso_bytes="$(isosize "$disk" 2>/dev/null || true)"
disk_bytes="$(blockdev --getsize64 "$disk")"
if [[ ! "$iso_bytes" =~ ^[0-9]+$ ]] || (( iso_bytes < 1000000000 )); then
  echo "Unable to determine ISO size on $disk"
  exit 1
fi

start_mib=$(( (iso_bytes + 1048575) / 1048576 + 8 ))
data_size_mib=1024
data_end_mib=$((start_mib + data_size_mib))
disk_mib=$(( disk_bytes / 1048576 ))
if (( disk_mib - data_end_mib < 2048 )); then
  echo "Not enough free space for data and persistence: ${disk_mib} MiB total"
  exit 1
fi

minimum_start_sector=$((start_mib * 2048))
collect_photo_partitions() {
  lsblk -lnpo NAME,TYPE,START "$disk" |
      awk -v minimum="$minimum_start_sector" \
        '$2 == "part" && $3 >= minimum {print $1, $3}' |
      sort -k2,2n |
      awk '{print $1}'
}

mapfile -t new_parts < <(collect_photo_partitions)
if (( ${#new_parts[@]} < 2 )); then
  data_start_sector=$((start_mib * 2048))
  data_size_sectors=$((data_size_mib * 2048))
  persistence_start_sector=$((data_end_mib * 2048))
  data_partition="${disk}3"
  persistence_partition="${disk}4"

  partition_table="$(sfdisk -d "$disk")"
  if grep -Fq "$data_partition :" <<<"$partition_table" ||
      grep -Fq "$persistence_partition :" <<<"$partition_table"; then
    echo "Expected MBR partition slots 3 and 4 are already occupied on $disk"
    exit 1
  fi

  echo "Creating PhotoBooth data and persistence partitions on $disk"
  printf '%s : start=%s, size=%s, type=c\n%s : start=%s, type=83\n' \
    "$data_partition" "$data_start_sector" "$data_size_sectors" \
    "$persistence_partition" "$persistence_start_sector" |
    sfdisk --append --force --no-reread "$disk"
  sync

  echo "Partition table was written; rebooting once before formatting"
  systemctl reboot
  exit 0
fi

data_part="${new_parts[${#new_parts[@]} - 2]}"
persistence_part="${new_parts[${#new_parts[@]} - 1]}"
if [[ ! -b "$data_part" || ! -b "$persistence_part" ]]; then
  echo "Invalid PhotoBooth partition devices"
  exit 1
fi

mkfs.vfat -F 32 -n PHOTOBOOTH "$data_part"
mkdir -p /mnt/photobooth-data
mount "$data_part" /mnt/photobooth-data
mkdir -p /mnt/photobooth-data/Templates \
  /mnt/photobooth-data/Output \
  /mnt/photobooth-data/Diagnostics \
  /mnt/photobooth-data/Updates/incoming \
  /mnt/photobooth-data/Updates/current \
  /mnt/photobooth-data/Updates/backups \
  /mnt/photobooth-data/Updates/installed \
  /mnt/photobooth-data/Updates/logs
cat > /mnt/photobooth-data/.photobooth-volume <<EOF
PHOTOBOOTH_OFFLINE_UPDATE_VOLUME_V1
volume_id=$(cat /proc/sys/kernel/random/uuid)
EOF
cat > /mnt/photobooth-data/PUT_TEMPLATES_HERE.txt <<'EOF'
Put each PhotoBooth template folder inside the Templates directory.

Example:
Templates/Event/2.png
Templates/Event/2.json
EOF
sync

mkfs.ext4 -F -L persistence "$persistence_part"
mkdir -p /mnt/photobooth-persistence
mount "$persistence_part" /mnt/photobooth-persistence
printf '/ union\n' > /mnt/photobooth-persistence/persistence.conf
sync
umount /mnt/photobooth-persistence

cp "$log_file" /mnt/photobooth-data/first-boot.log
sync
umount /mnt/photobooth-data

echo "PhotoBooth storage is ready; rebooting into kiosk mode"
systemctl reboot
