#!/usr/bin/env bash
set -euo pipefail

device_name="HID 1aad:0001"
output_file="$(mktemp)"
trap 'rm -f "$output_file"' EXIT

/usr/local/bin/photobooth-touch-setup

calibration_values="$(
  xinput list-props "$device_name" 2>/dev/null |
    sed -n 's/.*Evdev Axis Calibration[^:]*:[[:space:]]*//p' |
    head -n 1 |
    tr -d ','
)"

if [[ ! "$calibration_values" =~ ^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$ ]]; then
  echo "Не удалось прочитать текущий рабочий профиль сенсора." >&2
  exit 1
fi

read -r min_x max_x min_y max_y <<< "$calibration_values"

if ! timeout --foreground 90s xinput_calibrator \
    --device "$device_name" \
    --precalib "$min_x" "$max_x" "$min_y" "$max_y" \
    --misclick 0 \
    --output-type xorg.conf.d \
    --no-timeout >"$output_file"; then
  echo "Калибровка отменена или не завершена. Рабочий профиль восстановлен." >&2
  /usr/local/bin/photobooth-touch-setup
  exit 1
fi

if ! grep -q 'Option[[:space:]]*"Calibration"' "$output_file"; then
  cat "$output_file" >&2
  echo "The calibration tool did not return calibration values." >&2
  /usr/local/bin/photobooth-touch-setup
  exit 1
fi

if ! sudo -n /usr/local/sbin/photobooth-install-touch-calibration "$output_file"; then
  echo "Новая калибровка отклонена. Рабочий профиль восстановлен." >&2
  /usr/local/bin/photobooth-touch-setup
  exit 1
fi

/usr/local/bin/photobooth-touch-setup
echo "Калибровка проверена, применена и сохранена."
