                            BorderBrush="#85FFFFFF"
                            BorderThickness="1"
                            CornerRadius="32"
                            Margin="0,0,0,22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Как получился кадр?"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="ShotReviewProgressText"
                                           Text="Фото 1 из 4"
                                           Foreground="#D8FFFFFF"
                                           FontSize="17"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Width="360"
                                        Height="76"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource HomeGlassPillStyle}"
                                        Click="RetakeCurrentShotButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="28"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="Переснять"
                                                   FontSize="23"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Width="360"
                                        Height="76"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TemplatesPrimaryButtonStyle}"
                                        Click="AcceptCurrentShotButton_Click">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="28"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Text="Мне нравится"
                                                   FontSize="23"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="ShotFlyCard"
                        Grid.Row="1"
                        Width="560"
                        Height="380"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F2FFFFFF"
                        BorderBrush="White"
                        BorderThickness="6"
                        CornerRadius="20"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ShotFlyScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <TranslateTransform x:Name="ShotFlyTranslate" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Image x:Name="ShotFlyImage"
                           Stretch="UniformToFill" />
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PreviewPanel"
              Visibility="Collapsed"
              Background="#F7F8FC">
            <Grid>
                <Ellipse Width="700"
                         Height="700"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-330,0,0,-410"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#305AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620"
                         Height="620"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-350,-240,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#28FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Margin="34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PreviewBackButton"
                            HorizontalAlignment="Left"
                            Style="{StaticResource TemplatesAuxiliaryButtonStyle}"
                            Click="PreviewHomeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="#7B61FF"
                                       FontSize="25"
                                       Margin="0,0,10,0" />
                            <TextBlock x:Name="PreviewBackButtonText"
                                       Text="На главную"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText"
                                   Text="Предпросмотр"
                                   Foreground="#172238"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Проверьте фото перед печатью"
                                   Foreground="#68758C"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Button x:Name="RetakeButton"
                            Grid.Column="2"
                            Content="Переснять"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TemplatesGlassButtonStyle}"
                            Click="RetakeButton_Click" />
                </Grid>

                <Border Grid.Row="1"
                        Width="470"
                        MaxHeight="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#DDE2EC"
                        BorderThickness="1"
                        Background="White"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,12">
                    <Image x:Name="ResultPreviewImage"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Количество копий"
                               Foreground="#68758C"
                               FontSize="18"
                               TextAlignment="Center"
                               Margin="0,0,0,10" />

                    <StackPanel x:Name="CopyOptionsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <RadioButton x:Name="CopyOneOption"
                                     Content="1"
                                     Tag="1"
                                     GroupName="CopyCount"
                                     IsChecked="True"
                                     Style="{StaticResource CopyOptionStyle}"
                                     Checked="CopyCount_Checked" />
                        <RadioButton Content="2"
                                     Tag="2"
                                     GroupName="CopyCount"
                                     Style="{StaticResource CopyOptionStyle}"
                                     Checked="CopyCount_Checked" />
                        <RadioButton Content="3"
                                     Tag="3"
                                     GroupName="CopyCount"
                                     Margin="0"
                                     Style="{StaticResource CopyOptionStyle}"
                                     Checked="CopyCount_Checked" />
                    </StackPanel>

                    <TextBlock x:Name="PrintStatusText"
                               Width="620"
                               MinHeight="24"
                               Foreground="#9D345D"
                               FontSize="16"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Button x:Name="PrintButton"
                            Width="620"
                            Height="70"
                            Style="{StaticResource TemplatesPrimaryButtonStyle}"
                            Click="PrintButton_Click">
                        <Grid Margin="30,0">
                            <TextBlock Text="&#xE749;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="31"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PrintButtonText"
                                       Text="Печатать: 1"
                                       FontSize="25"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
