                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Печать фотографий"
                                   Foreground="#172238"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
