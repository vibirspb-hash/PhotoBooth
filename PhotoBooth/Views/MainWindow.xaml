<Window x:Class="PhotoBooth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Cursor="None"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="HomeBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#5AA7FF" Offset="0" />
            <GradientStop Color="#7B61FF" Offset="0.30" />
            <GradientStop Color="#B16CFF" Offset="0.52" />
            <GradientStop Color="#FF6EC7" Offset="0.76" />
            <GradientStop Color="#FFB278" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HomeGlassPillStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeGlassToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeGlassPillStyle}">
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="18,12" />
        </Style>

        <LinearGradientBrush x:Key="TemplatesBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#BED8FF" Offset="0" />
            <GradientStop Color="#D2C9FF" Offset="0.32" />
            <GradientStop Color="#E6CEFF" Offset="0.52" />
            <GradientStop Color="#FFD3EA" Offset="0.76" />
            <GradientStop Color="#FFE3C5" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TemplatesGlassButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,13" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#58FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplateListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Width" Value="216" />
            <Setter Property="Height" Value="382" />
            <Setter Property="Margin" Value="9" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="#20FFFFFF"
                                    BorderBrush="#76FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="30">
                                <ContentPresenter Margin="18" />
                            </Border>

                            <Border x:Name="SelectedBadge"
                                    Width="42"
                                    Height="42"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,16,16,0"
                                    Background="White"
                                    CornerRadius="21"
                                    Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#7B61FF"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#32FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#32FFFFFF" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="SelectedBadge"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplatesPrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#90FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#B05A7FFF" Offset="0" />
                                    <GradientStop Color="#B0B16CFF" Offset="0.48" />
                                    <GradientStop Color="#B0FF6EC7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyOptionStyle"
               TargetType="RadioButton">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#252A33" />
            <Setter Property="BorderBrush" Value="#4A5260" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="Background"
                                        Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#111318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="SessionPanel"
              Margin="80">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="560">
                <TextBlock Text="PHOTOBOOTH"
                           Foreground="White"
                           FontSize="44"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,34" />

                <StackPanel x:Name="CurrentSessionPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Найдена текущая сессия"
                               Foreground="#C9CED8"
                               FontSize="22"
                               TextAlignment="Center" />

                    <TextBlock x:Name="CurrentSessionNameText"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,28" />

                    <Button Content="Продолжить сессию"
                            Height="64"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Margin="0,0,0,14"
                            Click="ContinueSessionButton_Click" />

                    <Button Content="Начать новую сессию"
                            Height="52"
                            FontSize="18"
                            Click="ShowNewSessionButton_Click" />
                </StackPanel>

                <StackPanel x:Name="NewSessionPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Новая сессия"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,22" />

                    <TextBlock Text="Название мероприятия"
                               Foreground="#C9CED8"
                               FontSize="18"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="SessionNameTextBox"
                             Height="54"
                             FontSize="22"
                             Padding="12,8"
                             MaxLength="80"
                             KeyDown="SessionNameTextBox_KeyDown" />

                    <TextBlock x:Name="SessionErrorText"
                               Foreground="#FFB4A8"
                               FontSize="17"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MinHeight="28"
                               Margin="0,10,0,4" />

                    <Button Content="Создать сессию"
                            Height="64"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Click="CreateSessionButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid x:Name="HomePanel"
              Visibility="Collapsed"
              Background="{StaticResource HomeBackgroundBrush}">
            <Grid>
                <Ellipse Width="760"
                         Height="760"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-250,0,0,-360"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#805AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="680"
                         Height="680"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-260,-190,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620"
                         Height="620"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-220,-260"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#90FFE7B8" Offset="0" />
                            <GradientStop Color="#00FFE7B8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Margin="44,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="P H O T O   S T A R  ✦"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Normal"
                               VerticalAlignment="Center" />

                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="SettingsToggle"
                                      Style="{StaticResource HomeGlassToggleStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="28"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="Настройки"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup PlacementTarget="{Binding ElementName=SettingsToggle}"
                               Placement="Bottom"
                               HorizontalOffset="-94"
                               VerticalOffset="12"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=SettingsToggle}">
                            <Border Padding="16"
                                    Background="#D930285C"
                                    BorderBrush="#BFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="22">
                                <StackPanel>
                                    <TextBlock x:Name="ActiveSessionText"
                                               Foreground="White"
                                               FontSize="16"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="8,4,8,16" />

                                    <Button Content="История печати"
                                            Style="{StaticResource HomeMenuButtonStyle}"
                                            Click="PrintHistoryButton_Click" />

                                    <Button Content="Сменить сессию"
                                            Style="{StaticResource HomeMenuButtonStyle}"
                                            Click="ChangeSessionButton_Click" />

                                    <Button Content="Выход"
                                            Style="{StaticResource HomeMenuButtonStyle}"
                                            Margin="0"
                                            Click="ExitButton_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <Button Grid.Row="1"
                        Width="780"
                        MaxWidth="780"
                        MinHeight="410"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Background="#20FFFFFF"
                        BorderBrush="#DFFFFFFF"
                        BorderThickness="1"
                        Click="StartButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="StartGlassBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="54">
                                <Grid ClipToBounds="True">
                                    <Rectangle Height="170"
                                               VerticalAlignment="Top"
                                               IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop Color="#35FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="190"
                                                Height="190"
                                                CornerRadius="95"
                                                BorderBrush="#EFFFFFFF"
                                                BorderThickness="1"
                                                Margin="0,0,0,26">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0"
                                                                     EndPoint="1,1">
                                                    <GradientStop Color="#B05AA7FF" Offset="0" />
                                                    <GradientStop Color="#B0B16CFF" Offset="0.48" />
                                                    <GradientStop Color="#B0FF6EC7" Offset="0.72" />
                                                    <GradientStop Color="#B0FFB278" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Ellipse Margin="3"
                                                         Stroke="#55FFFFFF"
                                                         StrokeThickness="1" />
                                                <TextBlock Text="&#xE722;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="White"
                                                           FontSize="78"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="Начать фотосессию"
                                                   Foreground="White"
                                                   FontSize="50"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center" />

                                        <TextBlock Text="Создавайте яркие воспоминания"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   TextAlignment="Center"
                                                   Margin="0,14,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="StartGlassBorder"
                                            Property="Background"
                                            Value="#2EFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="StartGlassBorder"
                                            Property="Background"
                                            Value="#3AFFFFFF" />
                                    <Setter TargetName="StartGlassBorder"
                                            Property="Opacity"
                                            Value="0.92" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid Grid.Row="2"
                      HorizontalAlignment="Left">
                    <ToggleButton x:Name="InfoToggle"
                                  Style="{StaticResource HomeGlassToggleStyle}"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    Margin="0,0,14,0">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="White"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Инструкция по использованию"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=InfoToggle}"
                           Placement="Top"
                           VerticalOffset="-12"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=InfoToggle}">
                        <Border Width="360"
                                Padding="22"
                                Background="#E630285C"
                                BorderBrush="#BFFFFFFF"
                                BorderThickness="1"
                                CornerRadius="22">
                            <StackPanel>
                                <TextBlock Text="Как сделать фото"
                                           Foreground="White"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14" />
                                <TextBlock Text="1. Нажмите «Начать фотосессию».&#x0a;2. Выберите рамку.&#x0a;3. Встаньте перед камерой и смотрите в объектив.&#x0a;4. После съёмки выберите количество копий."
                                           Foreground="White"
                                           FontSize="18"
                                           LineHeight="28"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="HistoryPanel"
              Visibility="Collapsed"
              Margin="60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="История печати"
                           Foreground="White"
                           FontSize="40"
                           FontWeight="Bold"
                           TextAlignment="Center" />

                <TextBlock x:Name="HistorySessionNameText"
                           Foreground="#C9CED8"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,8,0,24" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="NoHistoryText"
                               Text="В этой сессии пока нет готовых коллажей"
                               Foreground="#C9CED8"
                               FontSize="22"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="220"
                                        Height="300"
                                        Margin="10"
                                        Padding="8"
                                        Click="HistoryItemButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Background="White"
                                                BorderBrush="#D5D8DE"
                                                BorderThickness="1">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayTime}"
                                                   FontSize="17"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="На главную"
                    Width="220"
                    Height="52"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Click="HistoryBackButton_Click" />
        </Grid>

        <Grid x:Name="TemplatesPanel"
              Visibility="Collapsed"
              Background="{StaticResource TemplatesBackgroundBrush}">
            <Grid>
                <Ellipse Width="740"
                         Height="740"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-280,0,0,-360"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#705AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620"
                         Height="620"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-270,-170,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#68FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

