                            <TextBlock Text="Макет"
                                       Foreground="#172238"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PrintProgressTemplateText"
                                       Text="Фотография"
                                       Foreground="#68758C"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0" />
                            <TextBlock x:Name="PrintProgressCopiesText"
                                       Text="1 копия"
                                       Foreground="#68758C"
                                       FontSize="16"
                                       Margin="0,4,0,0" />
