                                       FontSize="70"
                                       FontWeight="SemiBold"
                                       LineHeight="76"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="2"
                            Width="200"
                            Height="210"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24"
                            Background="#32FFFFFF"
                            BorderBrush="#70FFFFFF"
                            BorderThickness="1"
                            CornerRadius="28">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="54"
                                    Height="54"
                                    HorizontalAlignment="Left"
                                    Background="#30FFFFFF"
                                    BorderBrush="#75FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="27"
