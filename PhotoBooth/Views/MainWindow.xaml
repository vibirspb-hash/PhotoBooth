<Window x:Class="PhotoBooth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="CopyOptionStyle"
               TargetType="RadioButton">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#252A33" />
            <Setter Property="BorderBrush" Value="#4A5260" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="Background"
                                        Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#111318" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="SessionPanel"
              Margin="80">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="560">
                <TextBlock Text="PHOTOBOOTH"
                           Foreground="White"
                           FontSize="44"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,34" />

                <StackPanel x:Name="CurrentSessionPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Найдена текущая сессия"
                               Foreground="#C9CED8"
                               FontSize="22"
                               TextAlignment="Center" />

                    <TextBlock x:Name="CurrentSessionNameText"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,28" />

                    <Button Content="Продолжить сессию"
                            Height="64"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Margin="0,0,0,14"
                            Click="ContinueSessionButton_Click" />

                    <Button Content="Начать новую сессию"
                            Height="52"
                            FontSize="18"
                            Click="ShowNewSessionButton_Click" />
                </StackPanel>

                <StackPanel x:Name="NewSessionPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Новая сессия"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="0,0,0,22" />

                    <TextBlock Text="Название мероприятия"
                               Foreground="#C9CED8"
                               FontSize="18"
                               Margin="0,0,0,8" />

                    <TextBox x:Name="SessionNameTextBox"
                             Height="54"
                             FontSize="22"
                             Padding="12,8"
                             MaxLength="80"
                             KeyDown="SessionNameTextBox_KeyDown" />

                    <TextBlock x:Name="SessionErrorText"
                               Foreground="#FFB4A8"
                               FontSize="17"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MinHeight="28"
                               Margin="0,10,0,4" />

                    <Button Content="Создать сессию"
                            Height="64"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Click="CreateSessionButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="HomePanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">
            <TextBlock Text="PHOTOBOOTH"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,40" />

            <Button Content="НАЧАТЬ"
                    Height="80"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Margin="0,0,0,20"
                    Click="StartButton_Click" />

            <Button Content="Настройки"
                    Height="48"
                    FontSize="18"
                    Margin="0,0,0,12" />

            <Button Content="Выход"
                    Height="48"
                    FontSize="18"
                    Margin="0,0,0,12"
                    Click="ExitButton_Click" />

            <Button Content="Сменить сессию"
                    Height="44"
                    FontSize="16"
                    Click="ChangeSessionButton_Click" />

            <TextBlock x:Name="ActiveSessionText"
                       Foreground="#8F98A8"
                       FontSize="15"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0" />
        </StackPanel>

        <Grid x:Name="TemplatesPanel"
              Visibility="Collapsed"
              Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Выберите шаблон"
                       Foreground="White"
                       FontSize="42"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,32" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="NoTemplatesText"
                               Text="Пары PNG + JSON не найдены"
                               Foreground="#C9CED8"
                               FontSize="24"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="TemplatesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="230"
                                        Height="330"
                                        Margin="10"
                                        Padding="10"
                                        Click="TemplateButton_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Background="White"
                                                BorderBrush="#D5D8DE"
                                                BorderThickness="1">
                                            <Image Source="{Binding PreviewPath}"
                                                   Stretch="Uniform" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,12,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="Назад"
                    Width="220"
                    Height="52"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Click="BackToHomeButton_Click" />
        </Grid>

        <Grid x:Name="TemplateDetailsPanel"
              Visibility="Collapsed"
              Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520">
                <TextBlock x:Name="SelectedTemplateNameText"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,36" />

                <TextBlock x:Name="TemplateWidthText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplateHeightText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplatePhotosText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplateOverlayText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplateStatusText"
                           Foreground="#FFB4A8"
                           FontSize="20"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <Button Content="Назад"
                        Width="220"
                        Height="52"
                        FontSize="18"
                        Margin="0,0,16,0"
                        Click="BackToTemplatesButton_Click" />

                <Button Content="Продолжить"
                        x:Name="ContinueButton"
                        Width="220"
                        Height="52"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="ContinueButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="CountdownPanel"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CountdownText"
                           Text="3"
                           Foreground="White"
                           FontSize="180"
                           FontWeight="Bold"
                           TextAlignment="Center" />

                <TextBlock x:Name="CountdownCaption"
                           Text="Приготовьтесь"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="PreviewPanel"
              Visibility="Collapsed"
              Margin="48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Предпросмотр"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <Border Grid.Row="1"
                    BorderBrush="#343945"
                    BorderThickness="1"
                    Background="White"
                    Padding="8">
                <Image x:Name="ResultPreviewImage"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0">
                <TextBlock Text="Количество копий"
                           Foreground="#C9CED8"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <StackPanel x:Name="CopyOptionsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <RadioButton x:Name="CopyOneOption"
                                 Content="1"
                                 Tag="1"
                                 GroupName="CopyCount"
                                 IsChecked="True"
                                 Style="{StaticResource CopyOptionStyle}"
                                 Checked="CopyCount_Checked" />
                    <RadioButton Content="2"
                                 Tag="2"
                                 GroupName="CopyCount"
                                 Style="{StaticResource CopyOptionStyle}"
                                 Checked="CopyCount_Checked" />
                    <RadioButton Content="3"
                                 Tag="3"
                                 GroupName="CopyCount"
                                 Margin="0"
                                 Style="{StaticResource CopyOptionStyle}"
                                 Checked="CopyCount_Checked" />
                </StackPanel>

                <TextBlock x:Name="PrintStatusText"
                           Foreground="#C9CED8"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,18,0,0">
                <Button Content="На главную"
                        Width="200"
                        Height="52"
                        FontSize="18"
                        Margin="0,0,16,0"
                        Click="PreviewHomeButton_Click" />

                <Button Content="Переснять"
                        Width="200"
                        Height="52"
                        FontSize="18"
                        Margin="0,0,16,0"
                        Click="RetakeButton_Click" />

                <Button x:Name="PrintButton"
                        Content="Печатать"
                        Width="200"
                        Height="52"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="PrintButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
