<Window x:Class="PhotoBooth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Cursor="None"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="HomeBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#5AA7FF" Offset="0" />
            <GradientStop Color="#7B61FF" Offset="0.30" />
            <GradientStop Color="#B16CFF" Offset="0.52" />
            <GradientStop Color="#FF6EC7" Offset="0.76" />
            <GradientStop Color="#FFB278" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HomeGlassPillStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="24,13" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeGlassToggleStyle"
               TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="24,13" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeMenuButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeGlassPillStyle}">
            <Setter Property="MinWidth" Value="310" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="22,13" />
        </Style>

        <Style x:Key="HomeAuxiliaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource HomeGlassPillStyle}">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Padding" Value="28,13" />
        </Style>

        <LinearGradientBrush x:Key="TemplatesBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#BED8FF" Offset="0" />
            <GradientStop Color="#D2C9FF" Offset="0.32" />
            <GradientStop Color="#E6CEFF" Offset="0.52" />
            <GradientStop Color="#FFD3EA" Offset="0.76" />
            <GradientStop Color="#FFE3C5" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TemplatesGlassButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#24FFFFFF" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="22,13" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#58FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplatesAuxiliaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TemplatesGlassButtonStyle}">
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Padding" Value="28,13" />
        </Style>

        <Style x:Key="TemplateListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Width" Value="216" />
            <Setter Property="Height" Value="382" />
            <Setter Property="Margin" Value="9" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="CardBorder"
                                    Background="#20FFFFFF"
                                    BorderBrush="#76FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="30">
                                <ContentPresenter Margin="18" />
                            </Border>

                            <Border x:Name="SelectedBadge"
                                    Width="42"
                                    Height="42"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,16,16,0"
                                    Background="White"
                                    CornerRadius="21"
                                    Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#7B61FF"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#32FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#32FFFFFF" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="SelectedBadge"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplatesPrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#90FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#B05A7FFF" Offset="0" />
                                    <GradientStop Color="#B0B16CFF" Offset="0.48" />
                                    <GradientStop Color="#B0FF6EC7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyOptionStyle"
               TargetType="RadioButton">
            <Setter Property="Width" Value="106" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#D8FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6DCE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#9B86FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder"
                                        Property="Background"
                                        Value="#FFFFFF" />
                                <Setter TargetName="OptionBorder"
                                        Property="BorderBrush"
                                        Value="#7B61FF" />
                                <Setter TargetName="OptionBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter Property="Foreground" Value="#6F55E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#A8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="SelectionBrush" Value="#887B61FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="#32FFFFFF" />
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="310" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#50FFFFFF" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HistoryCardBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HistoryCardBorder"
                                        Property="Background"
                                        Value="#78FFFFFF" />
                                <Setter TargetName="HistoryCardBorder"
                                        Property="BorderBrush"
                                        Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HistoryCardBorder"
                                        Property="Opacity"
                                        Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="SessionPanel"
              Background="{StaticResource HomeBackgroundBrush}"
              ClipToBounds="True">
            <Grid>
                <Ellipse Width="760"
                         Height="760"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-280,0,0,-380"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#805AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="680"
                         Height="680"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-280,-200,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#78FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="560"
                         Height="560"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-180,-300"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80FFE7B8" Offset="0" />
                            <GradientStop Color="#00FFE7B8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Margin="42,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="P H O T O   S T A R  ✦"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border Grid.Row="1"
                        Width="760"
                        MinHeight="470"
                        Padding="64,46"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#25FFFFFF"
                        BorderBrush="#B8FFFFFF"
                        BorderThickness="1"
                        CornerRadius="46">
                    <StackPanel Width="590"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="92"
                                Height="92"
                                HorizontalAlignment="Center"
                                Background="#28FFFFFF"
                                BorderBrush="#C8FFFFFF"
                                BorderThickness="1"
                                CornerRadius="46"
                                Margin="0,0,0,20">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="42"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel x:Name="CurrentSessionPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="Продолжить работу"
                                       Foreground="White"
                                       FontSize="36"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="Найдена незавершённая сессия"
                                       Foreground="#D8FFFFFF"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       Margin="0,6,0,22" />

                            <Border Padding="22,16"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Margin="0,0,0,22">
                                <TextBlock x:Name="CurrentSessionNameText"
                                           Foreground="White"
                                           FontSize="25"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Button Height="68"
                                    Style="{StaticResource TemplatesPrimaryButtonStyle}"
                                    Margin="0,0,0,12"
                                    Click="ContinueSessionButton_Click">
                                <Grid Margin="26,0">
                                    <TextBlock Text="&#xE768;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="28"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Продолжить сессию"
                                               FontSize="23"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Height="60"
                                    Style="{StaticResource HomeGlassPillStyle}"
                                    Click="ShowNewSessionButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="24"
                                               Margin="0,0,10,0" />
                                    <TextBlock Text="Начать новую сессию"
                                               FontSize="20"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="NewSessionPanel"
                                    Visibility="Collapsed">
                            <TextBlock Text="Новая сессия"
                                       Foreground="White"
                                       FontSize="36"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="Создайте папку для фотографий мероприятия"
                                       Foreground="#D8FFFFFF"
                                       FontSize="18"
                                       TextAlignment="Center"
                                       Margin="0,6,0,24" />

                            <TextBlock Text="Название мероприятия"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,9" />

                            <TextBox x:Name="SessionNameTextBox"
                                     Height="62"
                                     MaxLength="80"
                                     Style="{StaticResource SessionTextBoxStyle}"
                                     KeyDown="SessionNameTextBox_KeyDown" />

                            <TextBlock x:Name="SessionErrorText"
                                       Foreground="#FFFFD8"
                                       FontSize="16"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MinHeight="26"
                                       Margin="0,9,0,5" />

                            <Button Height="68"
                                    Style="{StaticResource TemplatesPrimaryButtonStyle}"
                                    Click="CreateSessionButton_Click">
                                <Grid Margin="26,0">
                                    <TextBlock Text="&#xE710;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="28"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Создать сессию"
                                               FontSize="23"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="#C8FFFFFF"
                               FontSize="21"
                               Margin="0,0,10,0" />
                    <TextBlock Text="Все фотографии сохраняются внутри выбранной сессии"
                               Foreground="#D8FFFFFF"
                               FontSize="16"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="HomePanel"
              Visibility="Collapsed"
              Background="{StaticResource HomeBackgroundBrush}">
            <Grid>
                <Ellipse Width="760"
                         Height="760"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-250,0,0,-360"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#805AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="680"
                         Height="680"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-260,-190,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#80FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="620"
                         Height="620"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-220,-260"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#90FFE7B8" Offset="0" />
                            <GradientStop Color="#00FFE7B8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Margin="44,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="P H O T O   S T A R  ✦"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Normal"
                               VerticalAlignment="Center" />

                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="SettingsToggle"
                                      MinWidth="250"
                                      Style="{StaticResource HomeGlassToggleStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="28"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="Настройки"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Popup PlacementTarget="{Binding ElementName=SettingsToggle}"
                               Placement="Bottom"
                               HorizontalOffset="-100"
                               VerticalOffset="12"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=SettingsToggle}">
                            <Border Padding="20"
                                    Background="#D12C245A"
                                    BorderBrush="#BFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="28">
                                <StackPanel>
                                    <TextBlock x:Name="ActiveSessionText"
                                               Foreground="White"
                                               FontSize="16"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="8,4,8,16" />

                                    <Button Style="{StaticResource HomeMenuButtonStyle}"
                                            Click="PrintHistoryButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="История печати"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource HomeMenuButtonStyle}"
                                            Click="ChangeSessionButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="Сменить сессию"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
