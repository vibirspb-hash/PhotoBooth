                                       Foreground="#172238"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PrintProgressTimeText"
                                       Text="00:20"
                                       Foreground="#172238"
                                       FontSize="27"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="до завершения"
                                       Foreground="#68758C"
                                       FontSize="16"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Width="900"
                        Padding="24,15"
                        HorizontalAlignment="Center"
                        Background="#32FFFFFF"
                        BorderBrush="#70FFFFFF"
                        BorderThickness="1"
                        CornerRadius="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="#7B61FF"
                                       FontSize="23"
                                       Margin="0,0,9,0" />
                            <StackPanel>
                                <TextBlock Text="Подготовка"
                                           Foreground="#172238"
                                           FontSize="15" />
                                <TextBlock Text="Завершено"
                                           Foreground="#68758C"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#55FFFFFF" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="#7B61FF"
                                       FontSize="23"
                                       Margin="0,0,9,0" />
                            <StackPanel>
                                <TextBlock Text="Передача"
                                           Foreground="#172238"
                                           FontSize="15" />
                                <TextBlock Text="Завершено"
                                           Foreground="#68758C"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3"
                                Background="#55FFFFFF" />

                        <StackPanel Grid.Column="4"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Печать"
                                       Foreground="#172238"
                                       FontSize="15"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="PrintProgressPhaseText"
                                       Text="В процессе"
                                       Foreground="#7B61FF"
                                       FontSize="13"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="5"
                                Background="#55FFFFFF" />

                        <StackPanel Grid.Column="6"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Завершение"
                                       Foreground="#172238"
                                       FontSize="15"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="PrintCompletionPhaseText"
                                       Text="Ожидание"
                                       Foreground="#68758C"
                                       FontSize="13"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0">
                    <Button x:Name="PrintNextPhotoButton"
                            Width="560"
                            Height="68"
                            Style="{StaticResource TemplatesPrimaryButtonStyle}"
                            Click="PrintNextPhotoButton_Click">
                        <Grid Margin="28,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PrintNextPhotoButtonText"
                                       Grid.Column="1"
                                       Text="Следующее фото"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE72A;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="29"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <TextBlock Text="Задание останется в очереди принтера"
                               Foreground="#68758C"
                               FontSize="14"
                               TextAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
