                         Margin="-310,0,0,-390"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#665AA7FF" Offset="0" />
                            <GradientStop Color="#005AA7FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="680"
                         Height="680"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-300,-210,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#60FF6EC7" Offset="0" />
                            <GradientStop Color="#00FF6EC7" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Margin="34,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
