<Window x:Class="PhotoBooth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111318">
    <Grid>
        <StackPanel x:Name="HomePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">
            <TextBlock Text="PHOTOBOOTH"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,40" />

            <Button Content="НАЧАТЬ"
                    Height="80"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Margin="0,0,0,20"
                    Click="StartButton_Click" />

            <Button Content="Настройки"
                    Height="48"
                    FontSize="18"
                    Margin="0,0,0,12" />

            <Button Content="Выход"
                    Height="48"
                    FontSize="18"
                    Click="ExitButton_Click" />
        </StackPanel>

        <Grid x:Name="CountdownPanel"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CountdownText"
                           Text="3"
                           Foreground="White"
                           FontSize="180"
                           FontWeight="Bold"
                           TextAlignment="Center" />

                <TextBlock x:Name="CountdownCaption"
                           Text="Приготовьтесь"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
