                                 Stroke="#55FFFFFF"
                                 StrokeThickness="12" />
                        <Path x:Name="PrintProgressArc"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 195,18 A 177,177 0 1 1 52,302">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                    <GradientStop Color="#FF6EC7" Offset="0" />
                                    <GradientStop Color="#B16CFF" Offset="0.52" />
                                    <GradientStop Color="#5AA7FF" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="82"
                                    Height="82"
                                    HorizontalAlignment="Center"
                                    Background="#2AFFFFFF"
                                    BorderBrush="#70FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="41"
                                    Margin="0,0,0,12">
                                <TextBlock Text="&#xE749;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="#7B61FF"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock x:Name="PrintProgressStatusText"
                                       Text="Печатаем ваш макет"
                                       Foreground="#68758C"
                                       FontSize="19"
                                       TextAlignment="Center" />

                            <TextBlock x:Name="PrintProgressPercentText"
                                       Text="68%"
