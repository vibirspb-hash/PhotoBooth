<Window x:Class="PhotoBooth.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#111318">
    <Grid>
        <StackPanel x:Name="HomePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">
            <TextBlock Text="PHOTOBOOTH"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,40" />

            <Button Content="НАЧАТЬ"
                    Height="80"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Margin="0,0,0,20"
                    Click="StartButton_Click" />

            <Button Content="Настройки"
                    Height="48"
                    FontSize="18"
                    Margin="0,0,0,12" />

            <Button Content="Выход"
                    Height="48"
                    FontSize="18"
                    Click="ExitButton_Click" />
        </StackPanel>

        <Grid x:Name="TemplatesPanel"
              Visibility="Collapsed"
              Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Выберите шаблон"
                       Foreground="White"
                       FontSize="42"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,32" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <TextBlock x:Name="NoTemplatesText"
                               Text="Шаблоны не найдены"
                               Foreground="#C9CED8"
                               FontSize="24"
                               TextAlignment="Center"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="TemplatesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Height="72"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Margin="0,0,0,16"
                                        Click="TemplateButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="Назад"
                    Width="220"
                    Height="52"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Click="BackToHomeButton_Click" />
        </Grid>

        <Grid x:Name="TemplateDetailsPanel"
              Visibility="Collapsed"
              Margin="80">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520">
                <TextBlock x:Name="SelectedTemplateNameText"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,36" />

                <TextBlock x:Name="TemplateWidthText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplateHeightText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="TemplatePhotosText"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <Button Content="Назад"
                        Width="220"
                        Height="52"
                        FontSize="18"
                        Margin="0,0,16,0"
                        Click="BackToTemplatesButton_Click" />

                <Button Content="Продолжить"
                        Width="220"
                        Height="52"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Click="ContinueButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="CountdownPanel"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CountdownText"
                           Text="3"
                           Foreground="White"
                           FontSize="180"
                           FontWeight="Bold"
                           TextAlignment="Center" />

                <TextBlock x:Name="CountdownCaption"
                           Text="Приготовьтесь"
                           Foreground="#C9CED8"
                           FontSize="28"
                           TextAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
