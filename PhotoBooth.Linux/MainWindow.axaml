<Window x:Class="PhotoBooth.Linux.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Cursor="None"
        FontFamily="{DynamicResource Theme.FontFamily}"
        Background="{DynamicResource Theme.window.Brush}">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.buttonFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource Theme.buttonMinHeight}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.ButtonPadding}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.ButtonCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.glass">
            <Setter Property="Foreground" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.glass.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.glassBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%"
                                     EndPoint="100%,0%">
                    <GradientStop Color="{DynamicResource Theme.primaryGradient1.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Theme.primaryGradient2.Color}" Offset="0.52" />
                    <GradientStop Color="{DynamicResource Theme.primaryGradient3.Color}" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.primaryBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox.session">
            <Setter Property="Height" Value="{DynamicResource Theme.fieldHeight}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.FieldPadding}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.fieldFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.field.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.fieldBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.FieldCornerRadius}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.selection.Brush}" />
        </Style>

        <Style Selector="Button.keyboardKey">
            <Setter Property="Height" Value="{DynamicResource Theme.keyboardHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource Theme.keyboardMinWidth}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.KeyboardPadding}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font22}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.field.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.glassBorderStrong.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner18}" />
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Height" Value="{DynamicResource Theme.actionButtonHeight}" />
            <Setter Property="MinWidth" Value="{DynamicResource Theme.actionButtonMinWidth}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.actionButtonFontSize}" />
        </Style>

        <Style Selector="Button.pinKey">
            <Setter Property="Width" Value="{DynamicResource Theme.pinWidth}" />
            <Setter Property="Height" Value="{DynamicResource Theme.pinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font25}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="{DynamicResource Theme.PinPadding}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner22}" />
        </Style>

        <Style Selector="Button.calibrationOption">
            <Setter Property="MinHeight" Value="{DynamicResource Theme.optionMinHeight}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.OptionPadding}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font17}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner18}" />
        </Style>

        <Style Selector="Button.calibrationOption.selected">
            <Setter Property="Background" Value="{DynamicResource Theme.accent.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="CheckBox.scheduleToggle">
            <Setter Property="Foreground" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font18}" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style Selector="ComboBox.cameraSetting">
            <Setter Property="MinHeight" Value="{DynamicResource Theme.comboMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font19}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.glassBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner18}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.ComboPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.templateCard">
            <Setter Property="Width" Value="{DynamicResource Theme.templateCardWidth}" />
            <Setter Property="Height" Value="{DynamicResource Theme.templateCardHeight}" />
            <Setter Property="Margin" Value="{DynamicResource Theme.TemplateCardMargin}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.TemplateCardPadding}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.glassStrong.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.glassBorderSoft.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.CardCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.templateCard.selected">
            <Setter Property="Background" Value="{DynamicResource Theme.glassOpaque.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.accentDark.Brush}" />
            <Setter Property="BorderThickness" Value="5" />
        </Style>

        <Style Selector="Button.copyOption">
            <Setter Property="Width" Value="{DynamicResource Theme.copyOptionWidth}" />
            <Setter Property="Height" Value="{DynamicResource Theme.copyOptionHeight}" />
            <Setter Property="Margin" Value="{DynamicResource Theme.CopyOptionMargin}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.glassOpaque.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.controlBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner12}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font22}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.copyOption.selected">
            <Setter Property="Foreground" Value="{DynamicResource Theme.accentDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.accent.Brush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.historyCard">
            <Setter Property="Width" Value="{DynamicResource Theme.historyCardWidth}" />
            <Setter Property="Height" Value="{DynamicResource Theme.historyCardHeight}" />
            <Setter Property="Margin" Value="{DynamicResource Theme.HistoryCardMargin}" />
            <Setter Property="Padding" Value="{DynamicResource Theme.HistoryCardPadding}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.cardBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner18}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.historyFilter">
            <Setter Property="Foreground" Value="{DynamicResource Theme.textDark.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.controlBorder.Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.corner20}" />
            <Setter Property="FontSize" Value="{DynamicResource Theme.font17}" />
        </Style>

        <Style Selector="Button.historyFilter.selected">
            <Setter Property="Foreground" Value="{DynamicResource Theme.textOnColor.Brush}" />
            <Setter Property="Background" Value="{DynamicResource Theme.accent.Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.accent.Brush}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%"
                                     EndPoint="100%,100%">
                    <GradientStop Color="{DynamicResource Theme.backgroundGradient1.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Theme.backgroundGradient2.Color}" Offset="0.30" />
                    <GradientStop Color="{DynamicResource Theme.backgroundGradient3.Color}" Offset="0.52" />
                    <GradientStop Color="{DynamicResource Theme.backgroundGradient4.Color}" Offset="0.76" />
                    <GradientStop Color="{DynamicResource Theme.backgroundGradient5.Color}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Image x:Name="BrandingBackgroundImage"
               Stretch="UniformToFill"
               Opacity="{DynamicResource Theme.backgroundImageOpacity}"
               IsHitTestVisible="False"
               IsVisible="False" />

        <Ellipse Width="760"
                 Height="760"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-300,0,0,-390"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Theme.blueGlowStart.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Theme.blueGlowEnd.Color}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="680"
                 Height="680"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-300,-210,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource Theme.pinkGlowStart.Color}" Offset="0" />
                    <GradientStop Color="{DynamicResource Theme.pinkGlowEnd.Color}" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="SessionPanel"
              Margin="{DynamicResource Theme.SessionMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="SessionBrandText"
                       Text="{DynamicResource Text.brand}"
                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                       FontSize="{DynamicResource Theme.font20}"
                       FontWeight="SemiBold" />
                <Image x:Name="SessionLogoImage"
                       HorizontalAlignment="Left"
                       MaxHeight="{DynamicResource Theme.logoMaxHeight}"
                       IsHitTestVisible="False"
                       IsVisible="False" />
            </Grid>

            <Border Grid.Row="1"
                    Width="980"
                    MinHeight="590"
                    Padding="{DynamicResource Theme.MainPanelPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.glassPanel.Brush}"
                    BorderBrush="{DynamicResource Theme.glassBorderStrong.Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.corner46}"
                    BoxShadow="0 18 50 0 #300F235A">
                <StackPanel Width="880"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Theme.glassBadge.Brush}"
                            BorderBrush="{DynamicResource Theme.iconBorder.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner26}"
                            Margin="0,0,0,8">
                        <PathIcon Width="26"
                                  Height="26"
                                  Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <StackPanel x:Name="CurrentSessionPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.continueWorkTitle}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font36}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.unfinishedSession}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,22" />

                        <Border Padding="22,16"
                                Background="{DynamicResource Theme.glassFaint.Brush}"
                                BorderBrush="{DynamicResource Theme.sessionBorder.Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.corner20}"
                                Margin="0,0,0,22">
                            <TextBlock x:Name="CurrentSessionNameText"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font25}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Classes="primary actionButton"
                                Margin="0,0,0,12"
                                Click="ContinueSessionButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.continueSession}"
                                       FontSize="{DynamicResource Theme.font23}" />
                        </Button>

                        <Button Classes="glass"
                                Height="60"
                                Click="ShowNewSessionButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.startNewSession}"
                                       FontSize="{DynamicResource Theme.font20}" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="NewSessionPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.newSessionTitle}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.newSessionSubtitle}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,24" />

                        <TextBlock Text="{DynamicResource Text.eventName}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font17}"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,9" />

                        <TextBox x:Name="SessionNameTextBox"
                                 Classes="session"
                                 MaxLength="80"
                                 KeyDown="SessionNameTextBox_OnKeyDown" />

                        <TextBlock x:Name="SessionErrorText"
                                   Foreground="{DynamicResource Theme.warningText.Brush}"
                                   FontSize="{DynamicResource Theme.font16}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="26"
                                   Margin="0,9,0,5" />

                        <Button Classes="primary actionButton"
                                Click="CreateSessionButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.createSession}"
                                       FontSize="{DynamicResource Theme.font23}" />
                        </Button>

                        <StackPanel x:Name="SessionKeyboardPanel"
                                    Spacing="6"
                                    Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="SavedSessionsPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.chooseSession}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.savedSessionsSubtitle}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,18" />
                        <ScrollViewer Height="360"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SavedSessionsListPanel"
                                        Spacing="10" />
                        </ScrollViewer>
                        <Button Classes="primary actionButton"
                                Margin="0,16,0,0"
                                Click="ShowNewSessionButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.startNewSession}"
                                       FontSize="{DynamicResource Theme.font22}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HomePanel"
              Margin="{DynamicResource Theme.ScreenMargin}"
              IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBlock x:Name="HomeBrandText"
                           Text="{DynamicResource Text.homeBrand}"
                           Foreground="{DynamicResource Theme.textOnColor.Brush}"
                           FontSize="{DynamicResource Theme.font21}"
                           VerticalAlignment="Center" />
                    <Image x:Name="HomeLogoImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           MaxHeight="{DynamicResource Theme.logoMaxHeight}"
                           IsHitTestVisible="False"
                           IsVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Width="1"
                            Opacity="0"
                            IsHitTestVisible="False">
                    <Border x:Name="HomeCameraStatusBadge"
                            Width="54"
                            Height="54"
                            Background="{DynamicResource Theme.glassBadge.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner27}"
                            ToolTip.Tip="Проверяем камеру">
                        <PathIcon Width="25"
                                  Height="25"
                                  Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <Border x:Name="HomePrinterStatusBadge"
                            Width="54"
                            Height="54"
                            Background="{DynamicResource Theme.glassBadge.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner27}"
                            ToolTip.Tip="Проверяем принтер">
                        <PathIcon Width="27"
                                  Height="27"
                                  Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                  Data="M19,8 L5,8 C3.34,8 2,9.34 2,11 L2,17 L6,17 L6,21 L18,21 L18,17 L22,17 L22,11 C22,9.34 20.66,8 19,8 M16,19 L8,19 L8,14 L16,14 L16,19 M19,12 C18.45,12 18,11.55 18,11 C18,10.45 18.45,10 19,10 C19.55,10 20,10.45 20,11 C20,11.55 19.55,12 19,12 M18,3 L6,3 L6,7 L18,7 L18,3 Z" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="glass"
                        Width="{DynamicResource Theme.homeSettingsWidth}"
                        Height="{DynamicResource Theme.homeSettingsHeight}"
                        Background="{DynamicResource Theme.homeSettings.Brush}"
                        BorderBrush="{DynamicResource Theme.homeCardBorder.Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.corner32}"
                        Click="SettingsButton_OnClick">
                    <TextBlock Text="{DynamicResource Text.settings}"
                               FontSize="{DynamicResource Theme.font22}"
                               FontWeight="SemiBold" />
                </Button>
            </Grid>

            <Button Grid.Row="1"
                    Width="{DynamicResource Theme.homeCardWidth}"
                    MinHeight="{DynamicResource Theme.homeCardMinHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.homeCard.Brush}"
                    BorderBrush="{DynamicResource Theme.homeCardBorder.Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.corner60}"
                    BoxShadow="0 22 70 0 #380B164A"
                    Click="StartButton_OnClick">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="{DynamicResource Theme.homeOrbSize}"
                            Height="{DynamicResource Theme.homeOrbSize}"
                            CornerRadius="{DynamicResource Theme.corner215}"
                            BorderBrush="{DynamicResource Theme.homeCardBorder.Brush}"
                            BorderThickness="1"
                            BoxShadow="0 0 54 0 #70FFFFFF"
                            Margin="0,0,0,30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%"
                                                 EndPoint="100%,100%">
                                <GradientStop Color="{DynamicResource Theme.homeGradient1.Color}" Offset="0" />
                                <GradientStop Color="{DynamicResource Theme.homeGradient2.Color}" Offset="0.48" />
                                <GradientStop Color="{DynamicResource Theme.homeGradient3.Color}" Offset="0.72" />
                                <GradientStop Color="{DynamicResource Theme.homeGradient4.Color}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Width="{DynamicResource Theme.homeCameraIconSize}"
                                  Height="{DynamicResource Theme.homeCameraIconSize}"
                                  Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <TextBlock Text="{DynamicResource Text.startPhotoSession}"
                               Foreground="{DynamicResource Theme.textOnColor.Brush}"
                               FontSize="{DynamicResource Theme.font58}"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />

                    <TextBlock x:Name="HomeSubtitleText"
                               Text="{DynamicResource Text.homeSubtitle}"
                               Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                               FontSize="{DynamicResource Theme.font25}"
                               TextAlignment="Center"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="2">
                <Button MinWidth="390"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Click="InstructionButton_OnClick">
                    <TextBlock Text="{DynamicResource Text.instructions}"
                               Foreground="{DynamicResource Theme.homeInstruction.Brush}"
                               FontSize="{DynamicResource Theme.font19}"
                               FontWeight="SemiBold" />
                </Button>

                <TextBlock x:Name="ActiveSessionText"
                           Opacity="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                           FontSize="{DynamicResource Theme.font16}" />
            </Grid>
        </Grid>

        <Grid x:Name="TemplatesPanel"
              IsVisible="False">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource Theme.captureGradient1.Color}" Offset="0" />
                        <GradientStop Color="{DynamicResource Theme.captureGradient2.Color}" Offset="0.32" />
                        <GradientStop Color="{DynamicResource Theme.captureGradient3.Color}" Offset="0.52" />
                        <GradientStop Color="{DynamicResource Theme.captureGradient4.Color}" Offset="0.76" />
                        <GradientStop Color="{DynamicResource Theme.captureGradient5.Color}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="94" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Theme.textDark.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderLight.Brush}"
                            Click="TemplatesBackButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.back}"
                                   FontSize="{DynamicResource Theme.font20}" />
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource Text.templateTitle}"
                                   Foreground="{DynamicResource Theme.textDark.Brush}"
                                   FontSize="{DynamicResource Theme.font38}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.templateSubtitle}"
                                   Foreground="{DynamicResource Theme.textDarkSecondary.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border
                            Grid.Column="2"
                            MinWidth="190"
                            MinHeight="58"
                            Padding="24,13"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Theme.glassSubtle.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderLight.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner29}">
                        <TextBlock x:Name="TemplatesCountText"
                                   Foreground="{DynamicResource Theme.textDark.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,24,0,18">
                        <WrapPanel x:Name="TemplatesItemsPanel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ScrollViewer>

                    <TextBlock x:Name="TemplatesEmptyText"
                               IsVisible="False"
                               Foreground="{DynamicResource Theme.captureText.Brush}"
                               FontSize="{DynamicResource Theme.font25}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="SelectedTemplateText"
                               MinHeight="28"
                               Foreground="{DynamicResource Theme.textDarkSecondary.Brush}"
                               FontSize="{DynamicResource Theme.font17}"
                               TextAlignment="Center"
                               Margin="0,0,0,8" />

                    <Button x:Name="TemplateContinueButton"
                            Classes="primary actionButton"
                            Width="760"
                            IsEnabled="False"
                            Click="TemplateContinueButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.continue}"
                                   FontSize="{DynamicResource Theme.font24}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="CapturePanel"
              Background="{DynamicResource Theme.captureBackground.Brush}"
              IsVisible="False">
            <Image x:Name="LivePreviewImage"
                   Stretch="UniformToFill" />
            <Border Background="{DynamicResource Theme.captureOverlay.Brush}" />

            <Grid Margin="36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Click="CaptureBackButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.back}" />
                    </Button>

                    <Border Grid.Column="1"
                            MinWidth="330"
                            Padding="24,12"
                            Background="{DynamicResource Theme.overlayPanel.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner28}">
                        <TextBlock x:Name="CaptureProgressText"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font21}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>

                    <Border x:Name="CaptureDeviceBadge"
                            Grid.Column="2"
                            Padding="22,12"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Theme.overlayPanel.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.corner28}">
                        <TextBlock x:Name="CaptureDeviceBadgeText"
                                   Text="{DynamicResource Text.cameraName}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font16}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>

                <Border x:Name="AcceptedShotsRail"
                        Grid.Row="1"
                        Width="132"
                        Padding="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Theme.capturePanel1.Brush}"
                        BorderBrush="{DynamicResource Theme.glassBorderLight.Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.corner22}"
                        IsVisible="False">
                    <StackPanel x:Name="AcceptedShotsPanel" />
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="CaptureReadyOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Padding="30,20"
                                Background="{DynamicResource Theme.capturePanel2.Brush}"
                                BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.corner28}">
                            <StackPanel>
                                <TextBlock x:Name="CaptureReadyTitleText"
                                           Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                           FontSize="{DynamicResource Theme.font32}"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{DynamicResource Text.capturePrepare}"
                                           Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                           FontSize="{DynamicResource Theme.font18}"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <Border x:Name="CountdownOverlay"
                            Width="430"
                            Height="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.capturePanel3.Brush}"
                            BorderBrush="{DynamicResource Theme.glassBorderStrong.Brush}"
                            BorderThickness="3"
                            CornerRadius="{DynamicResource Theme.corner215}"
                            IsVisible="False">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CountdownText"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font128}"
                                       FontWeight="Bold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="CountdownCaption"
                                       Text="{DynamicResource Text.lookAtCamera}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font24}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ShotReviewOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,18"
                                IsVisible="False">
                        <Border Padding="24,12"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Theme.capturePanel4.Brush}"
                                BorderBrush="{DynamicResource Theme.glassBorderMedium.Brush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Theme.corner24}">
                            <TextBlock x:Name="ShotReviewProgressText"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font20}"
                                       FontWeight="SemiBold" />
                        </Border>

                    </StackPanel>

                    <Border x:Name="ShotFlyCard"
                            Width="620"
                            Height="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Theme.textOnColor.Brush}"
                            BorderBrush="{DynamicResource Theme.textOnColor.Brush}"
                            BorderThickness="8"
                            CornerRadius="{DynamicResource Theme.corner20}"
                            ClipToBounds="True"
                            RenderTransformOrigin="50%,50%"
                            IsVisible="False">
                        <Image x:Name="ShotFlyImage"
                               Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2"
                      VerticalAlignment="Bottom">
                    <Button x:Name="CaptureReadyActions"
                            Classes="primary actionButton"
                            Width="640"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Click="StartCaptureButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.takePhoto}"
                                   FontSize="{DynamicResource Theme.font25}" />
                    </Button>

                    <StackPanel x:Name="ShotReviewActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Spacing="20"
                                IsVisible="False">
                        <Button Classes="glass actionButton"
                                Width="340"
                                Click="RetakeCurrentShotButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.retake}"
                                       FontSize="{DynamicResource Theme.font25}" />
                        </Button>
                        <Button Classes="primary actionButton"
                                Width="340"
                                Click="AcceptCurrentShotButton_OnClick">
                            <TextBlock Text="{DynamicResource Text.approve}"
                                       FontSize="{DynamicResource Theme.font25}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="CaptureFooterText"
                           IsVisible="False" />
            </Grid>
        </Grid>

        <Grid x:Name="PreviewPanel"
              Background="{DynamicResource Theme.surfaceSoft.Brush}"
              IsVisible="False">
            <Grid Margin="38,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Button Classes="glass"
                            MinWidth="190"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Theme.textDark.Brush}"
                            BorderBrush="{DynamicResource Theme.controlBorder.Brush}"
                            Click="PreviewHomeButton_OnClick">
                        <TextBlock x:Name="PreviewBackButtonText"
                                   Text="{DynamicResource Text.home}" />
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText"
                                   Text="{DynamicResource Text.previewTitle}"
                                   Foreground="{DynamicResource Theme.inkStrong.Brush}"
                                   FontSize="{DynamicResource Theme.font38}"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PreviewSubtitleText"
                                   Text="{DynamicResource Text.previewSubtitle}"
                                   Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,18,0,12"
                        Padding="12"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Theme.textOnColor.Brush}"
                        CornerRadius="{DynamicResource Theme.corner12}"
                        BoxShadow="0 12 34 0 #260C1732">
                    <Image x:Name="ResultPreviewImage"
                           MaxWidth="520"
                           MaxHeight="480"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.copies}"
                               Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                               FontSize="{DynamicResource Theme.font18}"
                               TextAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CopyOneButton"
                                Classes="copyOption selected"
                                Tag="1"
                                Click="CopyCountButton_OnClick">1</Button>
                        <Button x:Name="CopyTwoButton"
                                Classes="copyOption"
                                Tag="2"
                                Click="CopyCountButton_OnClick">2</Button>
                        <Button x:Name="CopyThreeButton"
                                Classes="copyOption"
                                Tag="3"
                                Click="CopyCountButton_OnClick">3</Button>
                    </StackPanel>

                    <Button Classes="primary actionButton"
                            Width="680"
                            Margin="0,8,0,0"
                            Click="PrintButton_OnClick">
                        <TextBlock x:Name="PrintButtonText"
                                   Text="{DynamicResource Text.print}"
                                   FontSize="{DynamicResource Theme.font25}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PrintProgressPanel"
              Background="{DynamicResource Theme.surfaceSoft.Brush}"
              IsVisible="False">
            <StackPanel Width="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Text.printing}"
                           Foreground="{DynamicResource Theme.inkStrong.Brush}"
                           FontSize="{DynamicResource Theme.font42}"
                           FontWeight="Bold"
                           TextAlignment="Center" />
                <TextBlock Text="{DynamicResource Text.doNotDisconnect}"
                           Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                           FontSize="{DynamicResource Theme.font19}"
                           TextAlignment="Center"
                           Margin="0,4,0,30" />

                <Border Width="390"
                        Height="390"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Theme.textOnColor.Brush}"
                        BorderBrush="{DynamicResource Theme.previewBorder.Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.corner195}"
                        BoxShadow="0 15 45 0 #260C1732">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="▰"
                                   Foreground="{DynamicResource Theme.accent.Brush}"
                                   FontSize="{DynamicResource Theme.font72}"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrintProgressStatusText"
                                   Text="{DynamicResource Text.preparingJob}"
                                   Foreground="{DynamicResource Theme.previewText.Brush}"
                                   FontSize="{DynamicResource Theme.font20}"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrintProgressPercentText"
                                   Text="0%"
                                   Foreground="{DynamicResource Theme.inkStrong.Brush}"
                                   FontSize="{DynamicResource Theme.font70}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="PrintProgressDetailsText"
                           Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                           FontSize="{DynamicResource Theme.font18}"
                           TextAlignment="Center"
                           Margin="0,24,0,20" />

                <Button x:Name="PrintNextPhotoButton"
                        Classes="primary"
                        Width="560"
                        Height="72"
                        HorizontalAlignment="Center"
                        IsVisible="False"
                        Click="PrintNextPhotoButton_OnClick">
                    <TextBlock x:Name="PrintNextPhotoButtonText"
                               Text="{DynamicResource Text.nextPhoto}"
                               FontSize="{DynamicResource Theme.font24}" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="HistoryPanel"
              Background="{DynamicResource Theme.surfaceSoft.Brush}"
              IsVisible="False">
            <Grid Margin="38,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Theme.textDark.Brush}"
                            BorderBrush="{DynamicResource Theme.controlBorder.Brush}"
                            Click="HistoryBackButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.back}" />
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Text.history}"
                                   Foreground="{DynamicResource Theme.inkStrong.Brush}"
                                   FontSize="{DynamicResource Theme.font38}"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="HistorySessionNameText"
                                   Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0">
                    <StackPanel x:Name="HistorySessionFilterPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8" />
                </ScrollViewer>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <StackPanel x:Name="NoHistoryPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <Border Width="92"
                                Height="92"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Theme.accentSurface.Brush}"
                                CornerRadius="{DynamicResource Theme.corner46}"
                                Margin="0,0,0,18">
                            <TextBlock Text="▣"
                                       Foreground="{DynamicResource Theme.accent.Brush}"
                                       FontSize="{DynamicResource Theme.font44}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Text.historyEmpty}"
                                   Foreground="{DynamicResource Theme.textDark.Brush}"
                                   FontSize="{DynamicResource Theme.font27}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.historyEmptySubtitle}"
                                   Foreground="{DynamicResource Theme.textDarkMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font18}"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="HistoryItemsPanel"
                                   HorizontalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="OffHoursPanel"
              Background="{DynamicResource Theme.panelDark.Brush}"
              IsVisible="False">
            <StackPanel Width="680"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="120"
                        Height="120"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Theme.glassSubtle.Brush}"
                        BorderBrush="{DynamicResource Theme.glassBorderStrong.Brush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.corner60}"
                        Margin="0,0,0,22">
                    <TextBlock Text="◷"
                               Foreground="{DynamicResource Theme.textOnColor.Brush}"
                               FontSize="{DynamicResource Theme.font58}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{DynamicResource Text.closedTitle}"
                           Foreground="{DynamicResource Theme.textOnColor.Brush}"
                           FontSize="{DynamicResource Theme.font40}"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="OffHoursScheduleText"
                           Foreground="{DynamicResource Theme.textOnColorSoft.Brush}"
                           FontSize="{DynamicResource Theme.font21}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,28" />
                <Button Classes="glass"
                        Width="390"
                        HorizontalAlignment="Center"
                        Click="OffHoursSettingsButton_OnClick">Настройки оператора</Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="InstructionOverlay"
              Background="{DynamicResource Theme.overlaySoft.Brush}"
              IsVisible="False">
            <Border Width="760"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.panelDarkSoft.Brush}"
                    BorderBrush="{DynamicResource Theme.glassBorderStrong.Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.corner36}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Text.helpTitle}"
                               Foreground="{DynamicResource Theme.textOnColor.Brush}"
                               FontSize="{DynamicResource Theme.font34}"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="{DynamicResource Text.helpSteps}"
                               Foreground="{DynamicResource Theme.textOnColorBright.Brush}"
                               FontSize="{DynamicResource Theme.font22}"
                               LineHeight="38"
                               Margin="0,28"
                               TextWrapping="Wrap" />
                    <Button Classes="primary actionButton"
                            Click="InstructionCloseButton_OnClick">
                        <TextBlock Text="{DynamicResource Text.understood}"
                                   FontSize="{DynamicResource Theme.font23}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Background="{DynamicResource Theme.overlay.Brush}"
              IsVisible="False">
            <Border Width="820"
                    MinHeight="560"
                    Padding="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.panelDark.Brush}"
                    BorderBrush="{DynamicResource Theme.glassBorderStrong.Brush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.corner36}">
                <Grid>
                    <StackPanel x:Name="SettingsPinPanel">
                        <TextBlock x:Name="SettingsPinTitleText"
                                   Text="{DynamicResource Text.settingsTitle}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font36}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SettingsPinSubtitleText"
                                   Text="{DynamicResource Text.enterPin}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font19}"
                                   TextAlignment="Center"
                                   Margin="0,6,0,18" />
                        <TextBlock x:Name="SettingsPinDisplay"
                                   Text="○  ○  ○  ○"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font34}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16" />

                        <UniformGrid Columns="3"
                                     Rows="4"
                                     HorizontalAlignment="Center">
                            <Button Classes="glass pinKey" Tag="1" Margin="6" Click="SettingsPinDigitButton_OnClick">1</Button>
                            <Button Classes="glass pinKey" Tag="2" Margin="6" Click="SettingsPinDigitButton_OnClick">2</Button>
                            <Button Classes="glass pinKey" Tag="3" Margin="6" Click="SettingsPinDigitButton_OnClick">3</Button>
                            <Button Classes="glass pinKey" Tag="4" Margin="6" Click="SettingsPinDigitButton_OnClick">4</Button>
                            <Button Classes="glass pinKey" Tag="5" Margin="6" Click="SettingsPinDigitButton_OnClick">5</Button>
                            <Button Classes="glass pinKey" Tag="6" Margin="6" Click="SettingsPinDigitButton_OnClick">6</Button>
                            <Button Classes="glass pinKey" Tag="7" Margin="6" Click="SettingsPinDigitButton_OnClick">7</Button>
                            <Button Classes="glass pinKey" Tag="8" Margin="6" Click="SettingsPinDigitButton_OnClick">8</Button>
                            <Button Classes="glass pinKey" Tag="9" Margin="6" Click="SettingsPinDigitButton_OnClick">9</Button>
                            <Button Classes="glass pinKey" Margin="6" Click="SettingsPinClearButton_OnClick">C</Button>
                            <Button Classes="glass pinKey" Tag="0" Margin="6" Click="SettingsPinDigitButton_OnClick">0</Button>
                            <Button Classes="glass pinKey" Margin="6" Click="SettingsPinBackspaceButton_OnClick">⌫</Button>
                        </UniformGrid>

                        <TextBlock x:Name="SettingsPinErrorText"
                                   MinHeight="28"
                                   Foreground="{DynamicResource Theme.warningText.Brush}"
                                   FontSize="{DynamicResource Theme.font17}"
                                   TextAlignment="Center"
                                   Margin="0,8" />
                        <Button x:Name="SettingsPinCancelButton"
                                Classes="glass"
                                Click="SettingsCloseButton_OnClick">Отмена</Button>
                    </StackPanel>

                    <StackPanel x:Name="SettingsMenuPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.controlPanel}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font34}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SettingsSectionStatusText"
                                   Text="{DynamicResource Text.chooseSection}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font17}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="50"
                                   Margin="0,6,0,14" />

                        <UniformGrid Columns="3"
                                     Rows="3"
                                     HorizontalAlignment="Stretch">
                            <Button Classes="glass calibrationOption" Margin="7" Tag="history" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuHistory}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="camera" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuCamera}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="printer" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuPrinter}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="calibration" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuCalibration}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="schedule" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuSchedule}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="time" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuTime}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="restart" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuRestart}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="shutdown" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuShutdown}" />
                            <Button Classes="glass calibrationOption" Margin="7" Tag="session" Click="SettingsSectionButton_OnClick" Content="{DynamicResource Text.menuSession}" />
                        </UniformGrid>

                        <Button Classes="primary"
                                Height="68"
                                Margin="7,18,7,0"
                                Click="SettingsCloseButton_OnClick">Готово</Button>
                    </StackPanel>

                    <StackPanel x:Name="CameraSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.cameraSettings}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="CameraSettingsStatusText"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font15}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="48"
                                   Margin="0,4,0,10" />

                        <Grid ColumnDefinitions="190,*"
                              RowDefinitions="68,68,68,68">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource Text.iso}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraIsoComboBox"
                                      Grid.Row="0" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource Text.aperture}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraApertureComboBox"
                                      Grid.Row="1" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{DynamicResource Text.shutter}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraShutterComboBox"
                                      Grid.Row="2" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="{DynamicResource Text.whiteBalance}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraWhiteBalanceComboBox"
                                      Grid.Row="3" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*"
                              Margin="0,16,0,0">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="CameraSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="CameraRefreshButton_OnClick">Обновить</Button>
                            <Button Grid.Column="2"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="CameraApplyButton_OnClick">Применить</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PrinterSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.printCalibration}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrinterSettingsStatusText"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font15}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="42"
                                   Margin="0,4,0,10" />

                        <Grid ColumnDefinitions="180,72,130,72"
                              RowDefinitions="56,56,56"
                              HorizontalAlignment="Center">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource Text.offsetX}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font18}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="x:-1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterOffsetXText"
                                       Grid.Row="0" Grid.Column="2"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="x:1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource Text.offsetY}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font18}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="y:-1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterOffsetYText"
                                       Grid.Row="1" Grid.Column="2"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="y:1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="{DynamicResource Text.scale}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font18}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="scale:-0.1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterScaleText"
                                       Grid.Row="2" Grid.Column="2"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font19}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="scale:0.1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>
                        </Grid>

                        <Grid ColumnDefinitions="150,220,220"
                              RowDefinitions="58,58"
                              HorizontalAlignment="Center"
                              Margin="0,8,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{DynamicResource Text.quality}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font18}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="PrinterQualityFastButton"
                                    Grid.Row="0" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="Fast"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">300×300</Button>
                            <Button x:Name="PrinterQualityHighButton"
                                    Grid.Row="0" Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Tag="High"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">300×600</Button>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="{DynamicResource Text.cut}"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font18}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="PrinterCutStandardButton"
                                    Grid.Row="1" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="Standard"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">Обычный 10×15</Button>
                            <Button x:Name="PrinterCutTwoInchButton"
                                    Grid.Row="1" Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Tag="TwoInch"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">2 полосы 5×15</Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*"
                              Margin="0,16,0,0">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterResetButton_OnClick">Сбросить</Button>
                            <Button Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterTestButton_OnClick">Тест</Button>
                            <Button Grid.Column="3"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="PrinterSaveButton_OnClick">Сохранить</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ScheduleSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.scheduleTitle}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Text.scheduleSubtitle}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font16}"
                                   TextAlignment="Center"
                                   Margin="0,4,0,10" />

                        <CheckBox x:Name="ScheduleEnabledCheckBox"
                                  Classes="scheduleToggle"
                                  Content="{DynamicResource Text.enableSchedule}"
                                  HorizontalAlignment="Center" />

                        <Grid ColumnDefinitions="*,1,*"
                              Margin="0,8,0,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Text.scheduleStart}"
                                           Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                           FontSize="{DynamicResource Theme.font17}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="78,28,78"
                                      HorizontalAlignment="Center">
                                    <StackPanel Grid.Column="0">
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-hour:1"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleStartHourText"
                                                   Text="09"
                                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                                   FontSize="{DynamicResource Theme.font34}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-hour:-1"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text=":"
                                               Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                               FontSize="{DynamicResource Theme.font34}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-minute:5"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleStartMinuteText"
                                                   Text="30"
                                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                                   FontSize="{DynamicResource Theme.font34}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-minute:-5"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource Theme.glassLine.Brush}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Text.scheduleEnd}"
                                           Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                           FontSize="{DynamicResource Theme.font17}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="78,28,78"
                                      HorizontalAlignment="Center">
                                    <StackPanel Grid.Column="0">
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-hour:1"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleEndHourText"
                                                   Text="22"
                                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                                   FontSize="{DynamicResource Theme.font34}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-hour:-1"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text=":"
                                               Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                               FontSize="{DynamicResource Theme.font34}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-minute:5"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleEndMinuteText"
                                                   Text="00"
                                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                                   FontSize="{DynamicResource Theme.font34}"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-minute:-5"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ScheduleShutdownCheckBox"
                                  Classes="scheduleToggle"
                                  Content="{DynamicResource Text.shutdownOnSchedule}"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="ScheduleStatusText"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font15}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="36"
                                   Margin="0,2,0,6" />
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="ScheduleSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="ScheduleSaveButton_OnClick">Сохранить расписание</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SystemTimeSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="{DynamicResource Text.dateTime}"
                                   Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                   FontSize="{DynamicResource Theme.font32}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SystemTimeStatusText"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font16}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="46"
                                   Margin="0,4,0,12" />

                        <Grid ColumnDefinitions="90,90,125,36,90,90"
                              HorizontalAlignment="Center">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Text.day}" Foreground="{DynamicResource Theme.textOnColorMuted.Brush}" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="day:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeDayText" Text="01" Foreground="{DynamicResource Theme.textOnColor.Brush}" FontSize="{DynamicResource Theme.font32}" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="day:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Text.month}" Foreground="{DynamicResource Theme.textOnColorMuted.Brush}" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="month:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeMonthText" Text="01" Foreground="{DynamicResource Theme.textOnColor.Brush}" FontSize="{DynamicResource Theme.font32}" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="month:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Text.year}" Foreground="{DynamicResource Theme.textOnColorMuted.Brush}" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="year:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeYearText" Text="2026" Foreground="{DynamicResource Theme.textOnColor.Brush}" FontSize="{DynamicResource Theme.font32}" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="year:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="·"
                                       Foreground="{DynamicResource Theme.textOnColor.Brush}"
                                       FontSize="{DynamicResource Theme.font36}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{DynamicResource Text.hour}" Foreground="{DynamicResource Theme.textOnColorMuted.Brush}" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="hour:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeHourText" Text="12" Foreground="{DynamicResource Theme.textOnColor.Brush}" FontSize="{DynamicResource Theme.font32}" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="hour:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="{DynamicResource Text.minutes}" Foreground="{DynamicResource Theme.textOnColorMuted.Brush}" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="minute:5" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeMinuteText" Text="00" Foreground="{DynamicResource Theme.textOnColor.Brush}" FontSize="{DynamicResource Theme.font32}" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="minute:-5" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Text.hardwareClockHint}"
                                   Foreground="{DynamicResource Theme.textOnColorMuted.Brush}"
                                   FontSize="{DynamicResource Theme.font15}"
                                   TextAlignment="Center"
                                   Margin="0,18,0,8" />
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="SystemTimeBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="SystemTimeSaveButton_OnClick">Установить</Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
