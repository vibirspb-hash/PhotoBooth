<Window x:Class="PhotoBooth.Linux.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBooth"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="#5F72E9">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter, Arial, sans-serif" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="28,13" />
            <Setter Property="CornerRadius" Value="29" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.glass">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#BFFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.glass:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%"
                                     EndPoint="100%,0%">
                    <GradientStop Color="#9B70FF" Offset="0" />
                    <GradientStop Color="#C378E8" Offset="0.52" />
                    <GradientStop Color="#F37EC9" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#A8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox.session">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="22,14" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#EFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="SelectionBrush" Value="#887B61FF" />
        </Style>

        <Style Selector="Button.keyboardKey">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#EFFFFFFF" />
            <Setter Property="BorderBrush" Value="#B8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style Selector="Button.actionButton">
            <Setter Property="Height" Value="92" />
            <Setter Property="MinWidth" Value="320" />
            <Setter Property="FontSize" Value="25" />
        </Style>

        <Style Selector="Button.pinKey">
            <Setter Property="Width" Value="124" />
            <Setter Property="Height" Value="68" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>

        <Style Selector="Button.calibrationOption">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style Selector="Button.calibrationOption.selected">
            <Setter Property="Background" Value="#667B61FF" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="CheckBox.scheduleToggle">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style Selector="ComboBox.cameraSetting">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B8FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.templateCard">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="382" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#42FFFFFF" />
            <Setter Property="BorderBrush" Value="#8AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.templateCard.selected">
            <Setter Property="Background" Value="#78FFFFFF" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>

        <Style Selector="Button.copyOption">
            <Setter Property="Width" Value="106" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="#E8FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6DCE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.copyOption.selected">
            <Setter Property="Foreground" Value="#6F55E8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#7B61FF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.historyCard">
            <Setter Property="Width" Value="230" />
            <Setter Property="Height" Value="350" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.historyFilter">
            <Setter Property="Foreground" Value="#172238" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D6DCE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style Selector="Button.historyFilter.selected">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7B61FF" />
            <Setter Property="BorderBrush" Value="#7B61FF" />
        </Style>
    </Window.Styles>

    <Grid>
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%"
                                     EndPoint="100%,100%">
                    <GradientStop Color="#5AA7FF" Offset="0" />
                    <GradientStop Color="#7B61FF" Offset="0.30" />
                    <GradientStop Color="#B16CFF" Offset="0.52" />
                    <GradientStop Color="#FF6EC7" Offset="0.76" />
                    <GradientStop Color="#FFB278" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Ellipse Width="760"
                 Height="760"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-300,0,0,-390"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#805AA7FF" Offset="0" />
                    <GradientStop Color="#005AA7FF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="680"
                 Height="680"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-300,-210,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#78FF6EC7" Offset="0" />
                    <GradientStop Color="#00FF6EC7" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="SessionPanel"
              Margin="42,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="P H O T O   S T A R  ✦"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <Border Grid.Row="1"
                    Width="980"
                    MinHeight="590"
                    Padding="36,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#25FFFFFF"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="46"
                    BoxShadow="0 18 50 0 #300F235A">
                <StackPanel Width="880"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="#28FFFFFF"
                            BorderBrush="#C8FFFFFF"
                            BorderThickness="1"
                            CornerRadius="26"
                            Margin="0,0,0,8">
                        <PathIcon Width="26"
                                  Height="26"
                                  Foreground="White"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <StackPanel x:Name="CurrentSessionPanel"
                                IsVisible="False">
                        <TextBlock Text="Продолжить работу"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Найдена незавершенная сессия"
                                   Foreground="#D8FFFFFF"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,6,0,22" />

                        <Border Padding="22,16"
                                Background="#1AFFFFFF"
                                BorderBrush="#80FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                Margin="0,0,0,22">
                            <TextBlock x:Name="CurrentSessionNameText"
                                       Foreground="White"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Classes="primary actionButton"
                                Margin="0,0,0,12"
                                Click="ContinueSessionButton_OnClick">
                            <TextBlock Text="Продолжить сессию"
                                       FontSize="23" />
                        </Button>

                        <Button Classes="glass"
                                Height="60"
                                Click="ShowNewSessionButton_OnClick">
                            <TextBlock Text="＋  Начать новую сессию"
                                       FontSize="20" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="NewSessionPanel"
                                IsVisible="False">
                        <TextBlock Text="Новая сессия"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Создайте папку для фотографий мероприятия"
                                   Foreground="#D8FFFFFF"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,6,0,24" />

                        <TextBlock Text="Название мероприятия"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,9" />

                        <TextBox x:Name="SessionNameTextBox"
                                 Classes="session"
                                 MaxLength="80"
                                 KeyDown="SessionNameTextBox_OnKeyDown" />

                        <TextBlock x:Name="SessionErrorText"
                                   Foreground="#FFFFD8"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="26"
                                   Margin="0,9,0,5" />

                        <Button Classes="primary actionButton"
                                Click="CreateSessionButton_OnClick">
                            <TextBlock Text="Создать сессию"
                                       FontSize="23" />
                        </Button>

                        <StackPanel x:Name="SessionKeyboardPanel"
                                    Spacing="6"
                                    Margin="0,14,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="SavedSessionsPanel"
                                IsVisible="False">
                        <TextBlock Text="Выберите сессию"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Сохранённые сесии с этой флешки"
                                   Foreground="#D8FFFFFF"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,6,0,18" />
                        <ScrollViewer Height="360"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SavedSessionsListPanel"
                                        Spacing="10" />
                        </ScrollViewer>
                        <Button Classes="primary actionButton"
                                Margin="0,16,0,0"
                                Click="ShowNewSessionButton_OnClick">
                            <TextBlock Text="＋  Начать новую сессию"
                                       FontSize="22" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HomePanel"
              Margin="44,36"
              IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="P H O T O   S T A R  ✦"
                           Foreground="White"
                           FontSize="21"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center">
                    <Border x:Name="HomeCameraStatusBadge"
                            Width="54"
                            Height="54"
                            Background="#28FFFFFF"
                            BorderBrush="#90FFFFFF"
                            BorderThickness="1"
                            CornerRadius="27"
                            ToolTip.Tip="Проверяем камеру">
                        <PathIcon Width="25"
                                  Height="25"
                                  Foreground="White"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <Border x:Name="HomePrinterStatusBadge"
                            Width="54"
                            Height="54"
                            Background="#28FFFFFF"
                            BorderBrush="#90FFFFFF"
                            BorderThickness="1"
                            CornerRadius="27"
                            ToolTip.Tip="Проверяем принтер">
                        <PathIcon Width="27"
                                  Height="27"
                                  Foreground="White"
                                  Data="M19,8 L5,8 C3.34,8 2,9.34 2,11 L2,17 L6,17 L6,21 L18,21 L18,17 L22,17 L22,11 C22,9.34 20.66,8 19,8 M16,19 L8,19 L8,14 L16,14 L16,19 M19,12 C18.45,12 18,11.55 18,11 C18,10.45 18.45,10 19,10 C19.55,10 20,10.45 20,11 C20,11.55 19.55,12 19,12 M18,3 L6,3 L6,7 L18,7 L18,3 Z" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="glass"
                        MinWidth="250"
                        Click="SettingsButton_OnClick">
                    <TextBlock Text="⚙  Настройки"
                               FontSize="22" />
                </Button>
            </Grid>

            <Button Grid.Row="1"
                    Classes="glass"
                    Width="780"
                    MinHeight="410"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="54"
                    Click="StartButton_OnClick">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="190"
                            Height="190"
                            CornerRadius="95"
                            BorderBrush="#EFFFFFFF"
                            BorderThickness="1"
                            Margin="0,0,0,26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%"
                                                 EndPoint="100%,100%">
                                <GradientStop Color="#B05AA7FF" Offset="0" />
                                <GradientStop Color="#B0B16CFF" Offset="0.48" />
                                <GradientStop Color="#B0FF6EC7" Offset="0.72" />
                                <GradientStop Color="#B0FFB278" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Width="78"
                                  Height="78"
                                  Foreground="White"
                                  Data="M4,5 L7,5 L8.5,3 L15.5,3 L17,5 L20,5 C21.1,5 22,5.9 22,7 L22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,7 C2,5.9 2.9,5 4,5 M12,8 C8.7,8 6,10.7 6,14 C6,17.3 8.7,20 12,20 C15.3,20 18,17.3 18,14 C18,10.7 15.3,8 12,8 M12,10 C14.2,10 16,11.8 16,14 C16,16.2 14.2,18 12,18 C9.8,18 8,16.2 8,14 C8,11.8 9.8,10 12,10 Z" />
                    </Border>

                    <TextBlock Text="Начать фотосессию"
                               Foreground="White"
                               FontSize="50"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />

                    <TextBlock x:Name="HomeSubtitleText"
                               Text="Создавайте яркие воспоминания"
                               Foreground="White"
                               FontSize="24"
                               TextAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="2">
                <Button Classes="glass"
                        MinWidth="420"
                        HorizontalAlignment="Left"
                        Click="InstructionButton_OnClick">
                    <TextBlock Text="ⓘ  Инструкция по использованию"
                               FontSize="19" />
                </Button>

                <TextBlock x:Name="ActiveSessionText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="#D8FFFFFF"
                           FontSize="16" />
            </Grid>
        </Grid>

        <Grid x:Name="TemplatesPanel"
              IsVisible="False">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#BED8FF" Offset="0" />
                        <GradientStop Color="#D2C9FF" Offset="0.32" />
                        <GradientStop Color="#E6CEFF" Offset="0.52" />
                        <GradientStop Color="#FFD3EA" Offset="0.76" />
                        <GradientStop Color="#FFE3C5" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="38,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="94" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Foreground="#172238"
                            BorderBrush="#70FFFFFF"
                            Click="TemplatesBackButton_OnClick">
                        <TextBlock Text="‹  Назад"
                                   FontSize="20" />
                    </Button>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Выбор макета"
                                   Foreground="#172238"
                                   FontSize="38"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Выберите подходящий макет для печати"
                                   Foreground="#65718A"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border
                            Grid.Column="2"
                            MinWidth="190"
                            MinHeight="58"
                            Padding="24,13"
                            HorizontalAlignment="Right"
                            Background="#24FFFFFF"
                            BorderBrush="#70FFFFFF"
                            BorderThickness="1"
                            CornerRadius="29">
                        <TextBlock x:Name="TemplatesCountText"
                                   Foreground="#172238"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,24,0,18">
                        <WrapPanel x:Name="TemplatesItemsPanel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </ScrollViewer>

                    <TextBlock x:Name="TemplatesEmptyText"
                               IsVisible="False"
                               Foreground="#536078"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="SelectedTemplateText"
                               MinHeight="28"
                               Foreground="#65718A"
                               FontSize="17"
                               TextAlignment="Center"
                               Margin="0,0,0,8" />

                    <Button x:Name="TemplateContinueButton"
                            Classes="primary actionButton"
                            Width="760"
                            IsEnabled="False"
                            Click="TemplateContinueButton_OnClick">
                        <TextBlock Text="Продолжить  →"
                                   FontSize="24" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="CapturePanel"
              Background="#101525"
              IsVisible="False">
            <Image x:Name="LivePreviewImage"
                   Stretch="UniformToFill" />
            <Border Background="#220A1020" />

            <Grid Margin="36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Click="CaptureBackButton_OnClick">
                        <TextBlock Text="‹  Назад" />
                    </Button>

                    <Border Grid.Column="1"
                            MinWidth="330"
                            Padding="24,12"
                            Background="#B0202740"
                            BorderBrush="#90FFFFFF"
                            BorderThickness="1"
                            CornerRadius="28">
                        <TextBlock x:Name="CaptureProgressText"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>

                    <Border x:Name="CaptureDeviceBadge"
                            Grid.Column="2"
                            Padding="22,12"
                            HorizontalAlignment="Right"
                            Background="#B0202740"
                            BorderBrush="#90FFFFFF"
                            BorderThickness="1"
                            CornerRadius="28">
                        <TextBlock x:Name="CaptureDeviceBadgeText"
                                   Text="CANON EOS"
                                   Foreground="White"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>

                <Border x:Name="AcceptedShotsRail"
                        Grid.Row="1"
                        Width="132"
                        Padding="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#A0182038"
                        BorderBrush="#70FFFFFF"
                        BorderThickness="1"
                        CornerRadius="22"
                        IsVisible="False">
                    <StackPanel x:Name="AcceptedShotsPanel" />
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="CaptureReadyOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Padding="30,20"
                                Background="#B0182038"
                                BorderBrush="#90FFFFFF"
                                BorderThickness="1"
                                CornerRadius="28">
                            <StackPanel>
                                <TextBlock x:Name="CaptureReadyTitleText"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="Проверьте кадр и приготовьтесь"
                                           Foreground="#D8FFFFFF"
                                           FontSize="18"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <Border x:Name="CountdownOverlay"
                            Width="430"
                            Height="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#88182038"
                            BorderBrush="#B8FFFFFF"
                            BorderThickness="3"
                            CornerRadius="215"
                            IsVisible="False">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CountdownText"
                                       Foreground="White"
                                       FontSize="128"
                                       FontWeight="Bold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="CountdownCaption"
                                       Text="Смотрите в объектив"
                                       Foreground="White"
                                       FontSize="24"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ShotReviewOverlay"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,18"
                                IsVisible="False">
                        <Border Padding="24,12"
                                HorizontalAlignment="Center"
                                Background="#C0182038"
                                BorderBrush="#90FFFFFF"
                                BorderThickness="1"
                                CornerRadius="24">
                            <TextBlock x:Name="ShotReviewProgressText"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                        </Border>

                    </StackPanel>

                    <Border x:Name="ShotFlyCard"
                            Width="620"
                            Height="430"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="White"
                            BorderThickness="8"
                            CornerRadius="20"
                            ClipToBounds="True"
                            RenderTransformOrigin="50%,50%"
                            IsVisible="False">
                        <Image x:Name="ShotFlyImage"
                               Stretch="UniformToFill" />
                    </Border>
                </Grid>

                <Grid Grid.Row="2"
                      VerticalAlignment="Bottom">
                    <Button x:Name="CaptureReadyActions"
                            Classes="primary actionButton"
                            Width="640"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Click="StartCaptureButton_OnClick">
                        <TextBlock Text="Снять фото"
                                   FontSize="25" />
                    </Button>

                    <StackPanel x:Name="ShotReviewActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Spacing="20"
                                IsVisible="False">
                        <Button Classes="glass actionButton"
                                Width="340"
                                Click="RetakeCurrentShotButton_OnClick">
                            <TextBlock Text="↻  Переснять"
                                       FontSize="25" />
                        </Button>
                        <Button Classes="primary actionButton"
                                Width="340"
                                Click="AcceptCurrentShotButton_OnClick">
                            <TextBlock Text="Нравится  ✓"
                                       FontSize="25" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="CaptureFooterText"
                           IsVisible="False" />
            </Grid>
        </Grid>

        <Grid x:Name="PreviewPanel"
              Background="#F7F9FC"
              IsVisible="False">
            <Grid Margin="38,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Button Classes="glass"
                            MinWidth="190"
                            HorizontalAlignment="Left"
                            Foreground="#172238"
                            BorderBrush="#D6DCE8"
                            Click="PreviewHomeButton_OnClick">
                        <TextBlock x:Name="PreviewBackButtonText"
                                   Text="‹  На главную" />
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText"
                                   Text="Предпросмотр"
                                   Foreground="#141B2A"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PreviewSubtitleText"
                                   Text="Проверьте фото перед печатью"
                                   Foreground="#6B758A"
                                   FontSize="18"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,18,0,12"
                        Padding="12"
                        HorizontalAlignment="Center"
                        Background="White"
                        CornerRadius="12"
                        BoxShadow="0 12 34 0 #260C1732">
                    <Image x:Name="ResultPreviewImage"
                           MaxWidth="520"
                           MaxHeight="480"
                           Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Количество копий"
                               Foreground="#6B758A"
                               FontSize="18"
                               TextAlignment="Center" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="CopyOneButton"
                                Classes="copyOption selected"
                                Tag="1"
                                Click="CopyCountButton_OnClick">1</Button>
                        <Button x:Name="CopyTwoButton"
                                Classes="copyOption"
                                Tag="2"
                                Click="CopyCountButton_OnClick">2</Button>
                        <Button x:Name="CopyThreeButton"
                                Classes="copyOption"
                                Tag="3"
                                Click="CopyCountButton_OnClick">3</Button>
                    </StackPanel>

                    <Button Classes="primary actionButton"
                            Width="680"
                            Margin="0,8,0,0"
                            Click="PrintButton_OnClick">
                        <TextBlock x:Name="PrintButtonText"
                                   Text="Печать"
                                   FontSize="25" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PrintProgressPanel"
              Background="#F7F9FC"
              IsVisible="False">
            <StackPanel Width="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Печать фотографий"
                           Foreground="#141B2A"
                           FontSize="42"
                           FontWeight="Bold"
                           TextAlignment="Center" />
                <TextBlock Text="Пожалуйста, не отключайте устройство"
                           Foreground="#6B758A"
                           FontSize="19"
                           TextAlignment="Center"
                           Margin="0,4,0,30" />

                <Border Width="390"
                        Height="390"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="#E0E5EF"
                        BorderThickness="1"
                        CornerRadius="195"
                        BoxShadow="0 15 45 0 #260C1732">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="▰"
                                   Foreground="#7B61FF"
                                   FontSize="72"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrintProgressStatusText"
                                   Text="Подготовка задания"
                                   Foreground="#59657B"
                                   FontSize="20"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrintProgressPercentText"
                                   Text="0%"
                                   Foreground="#141B2A"
                                   FontSize="70"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="PrintProgressDetailsText"
                           Foreground="#6B758A"
                           FontSize="18"
                           TextAlignment="Center"
                           Margin="0,24,0,20" />

                <Button x:Name="PrintNextPhotoButton"
                        Classes="primary"
                        Width="560"
                        Height="72"
                        HorizontalAlignment="Center"
                        IsVisible="False"
                        Click="PrintNextPhotoButton_OnClick">
                    <TextBlock x:Name="PrintNextPhotoButtonText"
                               Text="Следующее фото"
                               FontSize="24" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="HistoryPanel"
              Background="#F7F9FC"
              IsVisible="False">
            <Grid Margin="38,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Button Classes="glass"
                            MinWidth="180"
                            HorizontalAlignment="Left"
                            Foreground="#172238"
                            BorderBrush="#D6DCE8"
                            Click="HistoryBackButton_OnClick">
                        <TextBlock Text="‹  Назад" />
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="История печати"
                                   Foreground="#141B2A"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="HistorySessionNameText"
                                   Foreground="#6B758A"
                                   FontSize="18"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0">
                    <StackPanel x:Name="HistorySessionFilterPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8" />
                </ScrollViewer>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <StackPanel x:Name="NoHistoryPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <Border Width="92"
                                Height="92"
                                HorizontalAlignment="Center"
                                Background="#ECE9FF"
                                CornerRadius="46"
                                Margin="0,0,0,18">
                            <TextBlock Text="▣"
                                       Foreground="#7B61FF"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="История пока пуста"
                                   Foreground="#172238"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Здесь появятся готовые макеты всех сесий"
                                   Foreground="#6B758A"
                                   FontSize="18"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="HistoryItemsPanel"
                                   HorizontalAlignment="Center" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="OffHoursPanel"
              Background="#F02B3150"
              IsVisible="False">
            <StackPanel Width="680"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="120"
                        Height="120"
                        HorizontalAlignment="Center"
                        Background="#24FFFFFF"
                        BorderBrush="#B8FFFFFF"
                        BorderThickness="1"
                        CornerRadius="60"
                        Margin="0,0,0,22">
                    <TextBlock Text="◷"
                               Foreground="White"
                               FontSize="58"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Фотобудка сейчас не работает"
                           Foreground="White"
                           FontSize="40"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="OffHoursScheduleText"
                           Foreground="#E5FFFFFF"
                           FontSize="21"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,28" />
                <Button Classes="glass"
                        Width="390"
                        HorizontalAlignment="Center"
                        Click="OffHoursSettingsButton_OnClick">Настройки оператора</Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="InstructionOverlay"
              Background="#B8101525"
              IsVisible="False">
            <Border Width="760"
                    Padding="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#EE2B3150"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="36">
                <StackPanel>
                    <TextBlock Text="Как пользоваться фотобудкой"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="1. Нажмите «Начать фотосессию».&#x0a;2. Выберите рамку.&#x0a;3. Встаньте перед камерой и нажмите «Снять фото».&#x0a;4. Подтвердите каждый удачный снимок.&#x0a;5. Выберите количество копий и нажмите «Печать»."
                               Foreground="#E8FFFFFF"
                               FontSize="22"
                               LineHeight="38"
                               Margin="0,28"
                               TextWrapping="Wrap" />
                    <Button Classes="primary actionButton"
                            Click="InstructionCloseButton_OnClick">
                        <TextBlock Text="Понятно"
                                   FontSize="23" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Background="#D0101525"
              IsVisible="False">
            <Border Width="820"
                    MinHeight="560"
                    Padding="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F02B3150"
                    BorderBrush="#B8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="36">
                <Grid>
                    <StackPanel x:Name="SettingsPinPanel">
                        <TextBlock x:Name="SettingsPinTitleText"
                                   Text="Настройки"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SettingsPinSubtitleText"
                                   Text="Введите код доступа"
                                   Foreground="#D8FFFFFF"
                                   FontSize="19"
                                   TextAlignment="Center"
                                   Margin="0,6,0,18" />
                        <TextBlock x:Name="SettingsPinDisplay"
                                   Text="○  ○  ○  ○"
                                   Foreground="White"
                                   FontSize="34"
                                   TextAlignment="Center"
                                   Margin="0,0,0,16" />

                        <UniformGrid Columns="3"
                                     Rows="4"
                                     HorizontalAlignment="Center">
                            <Button Classes="glass pinKey" Tag="1" Margin="6" Click="SettingsPinDigitButton_OnClick">1</Button>
                            <Button Classes="glass pinKey" Tag="2" Margin="6" Click="SettingsPinDigitButton_OnClick">2</Button>
                            <Button Classes="glass pinKey" Tag="3" Margin="6" Click="SettingsPinDigitButton_OnClick">3</Button>
                            <Button Classes="glass pinKey" Tag="4" Margin="6" Click="SettingsPinDigitButton_OnClick">4</Button>
                            <Button Classes="glass pinKey" Tag="5" Margin="6" Click="SettingsPinDigitButton_OnClick">5</Button>
                            <Button Classes="glass pinKey" Tag="6" Margin="6" Click="SettingsPinDigitButton_OnClick">6</Button>
                            <Button Classes="glass pinKey" Tag="7" Margin="6" Click="SettingsPinDigitButton_OnClick">7</Button>
                            <Button Classes="glass pinKey" Tag="8" Margin="6" Click="SettingsPinDigitButton_OnClick">8</Button>
                            <Button Classes="glass pinKey" Tag="9" Margin="6" Click="SettingsPinDigitButton_OnClick">9</Button>
                            <Button Classes="glass pinKey" Margin="6" Click="SettingsPinClearButton_OnClick">C</Button>
                            <Button Classes="glass pinKey" Tag="0" Margin="6" Click="SettingsPinDigitButton_OnClick">0</Button>
                            <Button Classes="glass pinKey" Margin="6" Click="SettingsPinBackspaceButton_OnClick">⌫</Button>
                        </UniformGrid>

                        <TextBlock x:Name="SettingsPinErrorText"
                                   MinHeight="28"
                                   Foreground="#FFFFD8"
                                   FontSize="17"
                                   TextAlignment="Center"
                                   Margin="0,8" />
                        <Button x:Name="SettingsPinCancelButton"
                                Classes="glass"
                                Click="SettingsCloseButton_OnClick">Отмена</Button>
                    </StackPanel>

                    <StackPanel x:Name="SettingsMenuPanel"
                                IsVisible="False">
                        <TextBlock Text="Панель управления"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SettingsSectionStatusText"
                                   Text="Выберите раздел"
                                   Foreground="#D8FFFFFF"
                                   FontSize="17"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="50"
                                   Margin="0,6,0,14" />

                        <WrapPanel HorizontalAlignment="Center">
                            <Button Classes="glass" Width="330" Margin="7" Tag="history" Click="SettingsSectionButton_OnClick">История печати</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="camera" Click="SettingsSectionButton_OnClick">Камера</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="printer" Click="SettingsSectionButton_OnClick">Принтер</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="calibration" Click="SettingsSectionButton_OnClick">Калибровка экрана</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="schedule" Click="SettingsSectionButton_OnClick">Таймер работы</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="time" Click="SettingsSectionButton_OnClick">Дата и время</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="restart" Click="SettingsSectionButton_OnClick">Перезагрузка</Button>
                            <Button Classes="glass" Width="330" Margin="7" Tag="session" Click="SettingsSectionButton_OnClick">Сменить сессию</Button>
                        </WrapPanel>

                        <Button Classes="primary"
                                Height="68"
                                Margin="7,18,7,0"
                                Click="SettingsCloseButton_OnClick">Готово</Button>
                    </StackPanel>

                    <StackPanel x:Name="CameraSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="Настройки Canon"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="CameraSettingsStatusText"
                                   Foreground="#D8FFFFFF"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="48"
                                   Margin="0,4,0,10" />

                        <Grid ColumnDefinitions="190,*"
                              RowDefinitions="68,68,68,68">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="ISO"
                                       Foreground="White"
                                       FontSize="19"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraIsoComboBox"
                                      Grid.Row="0" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Диафрагма"
                                       Foreground="White"
                                       FontSize="19"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraApertureComboBox"
                                      Grid.Row="1" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Выдержка"
                                       Foreground="White"
                                       FontSize="19"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraShutterComboBox"
                                      Grid.Row="2" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Text="Баланс белого"
                                       Foreground="White"
                                       FontSize="19"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CameraWhiteBalanceComboBox"
                                      Grid.Row="3" Grid.Column="1"
                                      Classes="cameraSetting"
                                      Margin="5" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*"
                              Margin="0,16,0,0">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="CameraSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="CameraRefreshButton_OnClick">Обновить</Button>
                            <Button Grid.Column="2"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="CameraApplyButton_OnClick">Применить</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PrinterSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="Калибровка печати"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="PrinterSettingsStatusText"
                                   Foreground="#D8FFFFFF"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="42"
                                   Margin="0,4,0,10" />

                        <Grid ColumnDefinitions="180,72,130,72"
                              RowDefinitions="56,56,56"
                              HorizontalAlignment="Center">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Смещение по X"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="x:-1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterOffsetXText"
                                       Grid.Row="0" Grid.Column="2"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="x:1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Смещение по Y"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="y:-1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterOffsetYText"
                                       Grid.Row="1" Grid.Column="2"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="y:1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Масштаб"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="scale:-0.1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">−</Button>
                            <TextBlock x:Name="PrinterScaleText"
                                       Grid.Row="2" Grid.Column="2"
                                       Foreground="White"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3"
                                    Classes="glass calibrationOption"
                                    Tag="scale:0.1"
                                    Margin="4"
                                    Click="PrinterAdjustmentButton_OnClick">+</Button>
                        </Grid>

                        <Grid ColumnDefinitions="150,220,220"
                              RowDefinitions="58,58"
                              HorizontalAlignment="Center"
                              Margin="0,8,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Качество"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <Button x:Name="PrinterQualityFastButton"
                                    Grid.Row="0" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="Fast"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">300×300</Button>
                            <Button x:Name="PrinterQualityHighButton"
                                    Grid.Row="0" Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Tag="High"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">300×600</Button>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Рез"
                                       Foreground="White"
                                       FontSize="18"
                                       VerticalAlignment="Center" />
                            <Button x:Name="PrinterCutStandardButton"
                                    Grid.Row="1" Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Tag="Standard"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">Обычный 10×15</Button>
                            <Button x:Name="PrinterCutTwoInchButton"
                                    Grid.Row="1" Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Tag="TwoInch"
                                    Margin="5"
                                    Click="PrinterOptionButton_OnClick">2 полосы 5×15</Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*"
                              Margin="0,16,0,0">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterResetButton_OnClick">Сбросить</Button>
                            <Button Grid.Column="2"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="PrinterTestButton_OnClick">Тест</Button>
                            <Button Grid.Column="3"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="PrinterSaveButton_OnClick">Сохранить</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ScheduleSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="Таймер работы"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="Автоматическое включение и выключение будки"
                                   Foreground="#D8FFFFFF"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   Margin="0,4,0,10" />

                        <CheckBox x:Name="ScheduleEnabledCheckBox"
                                  Classes="scheduleToggle"
                                  Content="Включить расписание работы"
                                  HorizontalAlignment="Center" />

                        <Grid ColumnDefinitions="*,1,*"
                              Margin="0,8,0,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Начало работы"
                                           Foreground="#D8FFFFFF"
                                           FontSize="17"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="78,28,78"
                                      HorizontalAlignment="Center">
                                    <StackPanel Grid.Column="0">
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-hour:1"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleStartHourText"
                                                   Text="09"
                                                   Foreground="White"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-hour:-1"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text=":"
                                               Foreground="White"
                                               FontSize="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-minute:5"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleStartMinuteText"
                                                   Text="30"
                                                   Foreground="White"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="start-minute:-5"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#55FFFFFF" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Завершение работы"
                                           Foreground="#D8FFFFFF"
                                           FontSize="17"
                                           TextAlignment="Center"
                                           Margin="0,0,0,6" />
                                <Grid ColumnDefinitions="78,28,78"
                                      HorizontalAlignment="Center">
                                    <StackPanel Grid.Column="0">
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-hour:1"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleEndHourText"
                                                   Text="22"
                                                   Foreground="White"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-hour:-1"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text=":"
                                               Foreground="White"
                                               FontSize="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2">
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-minute:5"
                                                Click="ScheduleStepButton_OnClick">+</Button>
                                        <TextBlock x:Name="ScheduleEndMinuteText"
                                                   Text="00"
                                                   Foreground="White"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   Margin="0,3" />
                                        <Button Classes="glass calibrationOption"
                                                Tag="end-minute:-5"
                                                Click="ScheduleStepButton_OnClick">−</Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ScheduleShutdownCheckBox"
                                  Classes="scheduleToggle"
                                  Content="Выключать после окончания и включать к началу"
                                  HorizontalAlignment="Center" />
                        <TextBlock x:Name="ScheduleStatusText"
                                   Foreground="#D8FFFFFF"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="36"
                                   Margin="0,2,0,6" />
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="ScheduleSettingsBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="ScheduleSaveButton_OnClick">Сохранить расписание</Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SystemTimeSettingsPanel"
                                IsVisible="False">
                        <TextBlock Text="Дата и время"
                                   Foreground="White"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="SystemTimeStatusText"
                                   Foreground="#D8FFFFFF"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MinHeight="46"
                                   Margin="0,4,0,12" />

                        <Grid ColumnDefinitions="90,90,125,36,90,90"
                              HorizontalAlignment="Center">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="День" Foreground="#D8FFFFFF" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="day:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeDayText" Text="01" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="day:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Месяц" Foreground="#D8FFFFFF" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="month:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeMonthText" Text="01" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="month:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Год" Foreground="#D8FFFFFF" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="year:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeYearText" Text="2026" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="year:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="·"
                                       Foreground="White"
                                       FontSize="36"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Час" Foreground="#D8FFFFFF" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="hour:1" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeHourText" Text="12" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="hour:-1" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="Минуты" Foreground="#D8FFFFFF" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="minute:5" Margin="4" Click="SystemTimeStepButton_OnClick">+</Button>
                                <TextBlock x:Name="SystemTimeMinuteText" Text="00" Foreground="White" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" />
                                <Button Classes="glass calibrationOption" Tag="minute:-5" Margin="4" Click="SystemTimeStepButton_OnClick">−</Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Время будет записано и в аппаратные часы компьютера"
                                   Foreground="#D8FFFFFF"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   Margin="0,18,0,8" />
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Classes="glass calibrationOption"
                                    Margin="5"
                                    Click="SystemTimeBackButton_OnClick">Назад</Button>
                            <Button Grid.Column="1"
                                    Classes="primary calibrationOption"
                                    Margin="5"
                                    Click="SystemTimeSaveButton_OnClick">Установить</Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
